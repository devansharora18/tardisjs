blueprint Home {
	style {
		.page {
			background: #0a0a0a;
			color: #ededed;
			min-height: 100vh;
			font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		}
		.wrap {
			max-width: 1080px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}
		.hero {
			padding: 72px 0 40px;
			text-align: center;
		}
		.badge {
			display: inline-block;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #3291ff;
			background: #0e2338;
			padding: 4px 12px;
			border-radius: 4px;
			margin-bottom: 20px;
		}
		.hero h1 {
			font-size: 44px;
			font-weight: 800;
			letter-spacing: -0.03em;
			line-height: 1.1;
			margin-bottom: 16px;
		}
		.hero h1 span {
			color: #3291ff;
		}
		.sub {
			font-size: 17px;
			color: #a1a1a1;
			max-width: 620px;
			margin: 0 auto;
			line-height: 1.6;
		}
		.sub code {
			font-family: 'JetBrains Mono', monospace;
			font-size: 14px;
			color: #ededed;
			background: #1a1a1a;
			padding: 1px 6px;
			border-radius: 4px;
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 16px;
			margin-top: 48px;
		}
		.card {
			display: block;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 10px;
			padding: 22px;
			transition: border-color 0.15s;
		}
		.card:hover {
			border-color: #3291ff;
			text-decoration: none;
		}
		.num {
			font-family: 'JetBrains Mono', monospace;
			font-size: 12px;
			color: #666666;
		}
		.card h3 {
			font-size: 17px;
			font-weight: 700;
			color: #ededed;
			margin: 8px 0 6px;
		}
		.card p {
			font-size: 13.5px;
			color: #a1a1a1;
			line-height: 1.55;
			margin-bottom: 12px;
		}
		.tags {
			font-family: 'JetBrains Mono', monospace;
			font-size: 11px;
			color: #3291ff;
			line-height: 1.7;
		}
		.foot {
			text-align: center;
			margin-top: 56px;
			font-size: 13px;
			color: #666666;
		}
		@media (max-width: 860px) {
			.grid { grid-template-columns: 1fr 1fr; }
		}
		@media (max-width: 600px) {
			.grid { grid-template-columns: 1fr; }
			.hero h1 { font-size: 32px; }
		}
	}
	ui {
		<div class="page">
			<SiteNav title="20 demos" />
			<div class="wrap">
				<header class="hero">
					<div class="badge">TardisJS Showcase</div>
					<h1>20 websites. <span>Zero CSS files.</span></h1>
					<p class="sub">Every demo below is a complete, professional-looking site built with <code>.tardis</code> blueprints only. All styling lives in <code>style</code> blocks — no stylesheets, no CSS files. Each one exercises a different slice of the framework.</p>
				</header>
				<div class="grid">
					<a class="card" href="/agency"><span class="num">01</span><h3>Agency Landing</h3><p>Hero, logos, features, testimonials, pricing, FAQ accordion, contact form.</p><div class="tags">$show · forms · components</div></a>
					<a class="card" href="/blog"><span class="num">02</span><h3>Blog</h3><p>Post index with dynamic article pages under /blog/:slug.</p><div class="tags">$each · $params · routing</div></a>
					<a class="card" href="/docs"><span class="num">03</span><h3>Docs Site</h3><p>Sidebar navigation with live search filtering across sections.</p><div class="tags">filter · $each · state</div></a>
					<a class="card" href="/store"><span class="num">04</span><h3>Store</h3><p>Product grid, detail pages, and a cart with computed totals.</p><div class="tags">$batch · computed · $params</div></a>
					<a class="card" href="/dashboard"><span class="num">05</span><h3>Dashboard</h3><p>KPI cards, SVG charts, and a sortable data table.</p><div class="tags">computed · SVG · sorting</div></a>
					<a class="card" href="/portfolio"><span class="num">06</span><h3>Portfolio</h3><p>Filterable work grid with a lightbox detail view.</p><div class="tags">filter · $if · modal</div></a>
					<a class="card" href="/auth"><span class="num">07</span><h3>Auth</h3><p>Login / signup tabs with inline validation errors.</p><div class="tags">forms · validation · $if</div></a>
					<a class="card" href="/chat"><span class="num">08</span><h3>Chat</h3><p>Message thread with bot replies and auto-scroll.</p><div class="tags">$each · script · events</div></a>
					<a class="card" href="/kanban"><span class="num">09</span><h3>Kanban</h3><p>Three-column board; move cards across columns.</p><div class="tags">arrays · $update · $each</div></a>
					<a class="card" href="/player"><span class="num">10</span><h3>Music Player</h3><p>Playlist, play state, and a live progress bar.</p><div class="tags">timers · state · events</div></a>
					<a class="card" href="/gallery"><span class="num">11</span><h3>Photo Gallery</h3><p>Category filter grid with a fullscreen viewer.</p><div class="tags">filter · $show · modal</div></a>
					<a class="card" href="/recipes"><span class="num">12</span><h3>Recipes</h3><p>Searchable recipe cards with dynamic detail pages.</p><div class="tags">search · $params · routing</div></a>
					<a class="card" href="/jobs"><span class="num">13</span><h3>Job Board</h3><p>Filter by department and location, with detail pages.</p><div class="tags">filter · computed · routing</div></a>
					<a class="card" href="/realestate"><span class="num">14</span><h3>Real Estate</h3><p>Listing filters and property detail pages.</p><div class="tags">filters · $params · computed</div></a>
					<a class="card" href="/weather"><span class="num">15</span><h3>Weather</h3><p>Live data via $fetch with loading and error states.</p><div class="tags">$fetch · $if · loading</div></a>
					<a class="card" href="/notes"><span class="num">16</span><h3>Notes</h3><p>CRUD notes persisted to localStorage.</p><div class="tags">CRUD · script · storage</div></a>
					<a class="card" href="/expenses"><span class="num">17</span><h3>Expenses</h3><p>Add expenses, computed totals, SVG spending chart.</p><div class="tags">forms · computed · SVG</div></a>
					<a class="card" href="/calendar"><span class="num">18</span><h3>Calendar</h3><p>Computed month grid with events and day detail.</p><div class="tags">computed · $each · $if</div></a>
					<a class="card" href="/settings"><span class="num">19</span><h3>Settings</h3><p>Toggles, selects, and profile forms with saved state.</p><div class="tags">$toggle · forms · $reset</div></a>
					<a class="card" href="/ui"><span class="num">20</span><h3>UI Kit</h3><p>Every primitive: buttons, inputs, tables, badges, alerts.</p><div class="tags">kitchen sink · components</div></a>
				</div>
				<p class="foot">Built with TardisJS blueprints. No stylesheets were harmed.</p>
			</div>
		</div>
	}
}
