blueprint Home {
	state {
		name: string = ""
		email: string = ""
		bio: string = ""
		password: string = ""
		nameError: string = ""
		emailError: string = ""
		bioError: string = ""
		passwordError: string = ""
		nameTouched: boolean = false
		emailTouched: boolean = false
		bioTouched: boolean = false
		passwordTouched: boolean = false
		submitTried: boolean = false
		submitted: boolean = false
	}
	computed {
		nameCount: state.name.length + " / 40"
		emailCount: state.email.length + " / 60"
		bioCount: state.bio.length + " / 140"
		passwordCount: state.password.length + " / 72"
		strength: state.password === "" ? "Enter a password" : (state.password.length < 8 ? "Weak — needs 8+ characters" : (state.password.length < 12 ? "Okay — 12+ is strong" : "Strong"))
		strengthClass: state.password === "" ? "meter meter-none" : (state.password.length < 8 ? "meter meter-weak" : (state.password.length < 12 ? "meter meter-ok" : "meter meter-strong"))
	}
	methods {
		validateName: () => $update(state.nameError, state.name === "" ? "Name is required" : (state.name.length < 2 ? "Use 2 or more characters" : ""))
		validateEmail: () => $update(state.emailError, state.email === "" ? "Email is required" : (state.email.includes("@") ? "" : "Enter a valid email"))
		validateBio: () => $update(state.bioError, state.bio.length > 140 ? "Bio must be 140 characters or fewer" : "")
		validatePassword: () => $update(state.passwordError, state.password === "" ? "Password is required" : (state.password.length < 8 ? "Use 8 or more characters" : ""))
		blurName: () => $batch(() => ($update(state.nameTouched, true), methods.validateName()))
		blurEmail: () => $batch(() => ($update(state.emailTouched, true), methods.validateEmail()))
		blurBio: () => $batch(() => ($update(state.bioTouched, true), methods.validateBio()))
		blurPassword: () => $batch(() => ($update(state.passwordTouched, true), methods.validatePassword()))
		submit: () => $batch(() => ($update(state.submitTried, true), methods.validateName(), methods.validateEmail(), methods.validateBio(), methods.validatePassword(), $update(state.submitted, state.name.length >= 2 && state.email.includes("@") && state.bio.length <= 140 && state.password.length >= 8)))
		reset: () => $batch(() => ($update(state.name, ""), $update(state.email, ""), $update(state.bio, ""), $update(state.password, ""), $update(state.nameError, ""), $update(state.emailError, ""), $update(state.bioError, ""), $update(state.passwordError, ""), $update(state.nameTouched, false), $update(state.emailTouched, false), $update(state.bioTouched, false), $update(state.passwordTouched, false), $update(state.submitTried, false), $update(state.submitted, false)))
	}
	style {
		.page {
			background: #0a0a0a;
			color: #ededed;
			min-height: 100vh;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}
		.wrap {
			max-width: 620px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}
		.hero {
			text-align: center;
			padding: 72px 0 8px;
		}
		.kicker {
			font-size: 13px;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: #3291ff;
			margin-bottom: 14px;
		}
		.hero h1 {
			font-size: 38px;
			font-weight: 800;
			letter-spacing: -0.03em;
			margin-bottom: 14px;
		}
		.hero p {
			font-size: 16px;
			color: #a1a1a1;
		}
		.form {
			margin-top: 40px;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 12px;
			padding: 32px;
			display: flex;
			flex-direction: column;
			gap: 20px;
		}
		.field label {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			font-size: 13px;
			font-weight: 600;
			margin-bottom: 8px;
		}
		.count {
			font-weight: 400;
			font-size: 12px;
			color: #666666;
		}
		.count-over {
			font-weight: 400;
			font-size: 12px;
			color: #f85149;
		}
		.field input {
			width: 100%;
			box-sizing: border-box;
			background: #0a0a0a;
			border: 1px solid #404040;
			border-radius: 8px;
			color: #ededed;
			font-size: 14px;
			padding: 10px 12px;
			font-family: inherit;
		}
		.field textarea {
			width: 100%;
			box-sizing: border-box;
			min-height: 84px;
			resize: vertical;
			background: #0a0a0a;
			border: 1px solid #404040;
			border-radius: 8px;
			color: #ededed;
			font-size: 14px;
			padding: 10px 12px;
			font-family: inherit;
		}
		.error {
			font-size: 13px;
			color: #f85149;
			margin-top: 6px;
		}
		.meter-track {
			margin-top: 8px;
			height: 6px;
			border-radius: 3px;
			background: #262626;
			overflow: hidden;
		}
		.meter {
			height: 100%;
			border-radius: 3px;
		}
		.meter-none {
			width: 0%;
		}
		.meter-weak {
			width: 33%;
			background: #f85149;
		}
		.meter-ok {
			width: 66%;
			background: #d29922;
		}
		.meter-strong {
			width: 100%;
			background: #3fb950;
		}
		.strength-label {
			font-size: 12px;
			color: #a1a1a1;
			margin-top: 6px;
		}
		.actions {
			display: flex;
			gap: 8px;
		}
		.primary {
			flex: 1;
			background: #ededed;
			color: #0a0a0a;
			border: none;
			border-radius: 8px;
			font-size: 14px;
			font-weight: 600;
			padding: 10px 18px;
			cursor: pointer;
			font-family: inherit;
		}
		.ghost {
			background: transparent;
			color: #ededed;
			border: 1px solid #404040;
			border-radius: 8px;
			font-size: 14px;
			font-weight: 600;
			padding: 10px 18px;
			cursor: pointer;
			font-family: inherit;
		}
		.success {
			margin-top: 24px;
			background: #0d2313;
			border: 1px solid #1f6b34;
			border-radius: 12px;
			padding: 24px 32px;
			text-align: center;
		}
		.success h3 {
			font-size: 20px;
			font-weight: 800;
			color: #7ee787;
			margin-bottom: 8px;
		}
		.success p {
			font-size: 14px;
			color: #a1a1a1;
		}
		.foot {
			text-align: center;
			margin-top: 64px;
			font-size: 13px;
			color: #666666;
		}
	}
	ui {
		<div class="page">
			<div class="wrap">
				<header class="hero">
					<div class="kicker">Blueprint state only</div>
					<h1>Profile settings</h1>
					<p>Per-field touched and error state, validate on blur and on submit, live counters, and a strength meter.</p>
				</header>
				<div class="form">
					<div class="field">
						<label>Display name <span class="count">{computed.nameCount}</span></label>
						<input class="input-name" value={state.name} @input={(e) => $update(state.name, e.target.value)} @blur={methods.blurName} placeholder="Ada Lovelace" />
						$show(state.nameError !== "" && (state.nameTouched || state.submitTried)) {
							<p class="error">{state.nameError}</p>
						}
					</div>
					<div class="field">
						<label>Email <span class="count">{computed.emailCount}</span></label>
						<input class="input-email" value={state.email} @input={(e) => $update(state.email, e.target.value)} @blur={methods.blurEmail} placeholder="ada@example.com" />
						$show(state.emailError !== "" && (state.emailTouched || state.submitTried)) {
							<p class="error">{state.emailError}</p>
						}
					</div>
					<div class="field">
						<label>Bio <span class={state.bio.length > 140 ? "count-over" : "count"}>{computed.bioCount}</span></label>
						<textarea class="input-bio" value={state.bio} @input={(e) => $update(state.bio, e.target.value)} @blur={methods.blurBio} placeholder="What are you working on? (optional, 140 max)"></textarea>
						$show(state.bioError !== "" && (state.bioTouched || state.submitTried)) {
							<p class="error">{state.bioError}</p>
						}
					</div>
					<div class="field">
						<label>Password <span class="count">{computed.passwordCount}</span></label>
						<input class="input-password" type="password" value={state.password} @input={(e) => $update(state.password, e.target.value)} @blur={methods.blurPassword} placeholder="8+ characters" />
						<div class="meter-track"><div class={computed.strengthClass}></div></div>
						<p class="strength-label">{computed.strength}</p>
						$show(state.passwordError !== "" && (state.passwordTouched || state.submitTried)) {
							<p class="error">{state.passwordError}</p>
						}
					</div>
					<div class="actions">
						<button class="primary" @click={methods.submit}>Save profile</button>
						<button class="ghost" @click={methods.reset}>Reset</button>
					</div>
				</div>
				$show(state.submitted) {
					<div class="success">
						<h3>Profile saved</h3>
						<p>{state.name} · {state.email}</p>
					</div>
				}
				<p class="foot">© 2026 Forms Demo · Built with TardisJS blueprints</p>
			</div>
		</div>
	}
}
