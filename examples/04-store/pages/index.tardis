blueprint Home {
	state {
		cart: array = []
		total: number = 0
		ordered: boolean = false
	}
	computed {
		count: state.cart.length
	}
	methods {
		addToCart: (id, name, price) => $batch(() => ($update(state.cart, [...state.cart, { id: id, name: name, price: price }]), $update(state.total, state.total + price)))
		removeFromCart: (id, price) => $batch(() => ($update(state.cart, state.cart.filter((x, i) => i !== state.cart.map((y) => y.id).indexOf(id))), $update(state.total, state.total - price)))
		clearCart: () => $batch(() => ($update(state.cart, []), $update(state.total, 0), $update(state.ordered, false)))
		checkout: () => $batch(() => ($update(state.cart, []), $update(state.total, 0), $update(state.ordered, true)))
	}
	style {
		.page {
			background: #0a0a0a;
			color: #ededed;
			min-height: 100vh;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}
		.wrap {
			max-width: 1080px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}
		.topbar {
			position: sticky;
			top: 0;
			z-index: 50;
			background: rgba(10, 10, 10, 0.92);
			border-bottom: 1px solid #262626;
		}
		.topbar-inner {
			max-width: 1080px;
			margin: 0 auto;
			padding: 0 24px;
			height: 56px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.brand {
			font-weight: 800;
			font-size: 16px;
			letter-spacing: -0.02em;
		}
		.bag {
			font-size: 13px;
			font-weight: 600;
			color: #0a0a0a;
			background: #ededed;
			padding: 8px 16px;
			border-radius: 6px;
		}
		.hero {
			text-align: center;
			padding: 64px 0 40px;
		}
		.hero h1 {
			font-size: 44px;
			font-weight: 800;
			letter-spacing: -0.03em;
			margin-bottom: 12px;
		}
		.hero p {
			font-size: 17px;
			color: #a1a1a1;
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 16px;
			margin-top: 32px;
		}
		.bagbox {
			margin-top: 56px;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 12px;
			padding: 32px;
		}
		.bagbox h2 {
			font-size: 22px;
			font-weight: 800;
			margin-bottom: 6px;
		}
		.bagbox-sub {
			font-size: 13px;
			color: #888888;
			margin-bottom: 20px;
		}
		.line {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 12px 0;
			border-top: 1px solid #262626;
			font-size: 14px;
		}
		.line button {
			background: transparent;
			border: 1px solid #404040;
			color: #a1a1a1;
			border-radius: 6px;
			font-size: 12px;
			padding: 6px 12px;
			cursor: pointer;
			font-family: inherit;
		}
		.line button:hover {
			color: #ff7b72;
			border-color: #ff7b72;
		}
		.total {
			display: flex;
			justify-content: space-between;
			font-size: 17px;
			font-weight: 800;
			padding: 16px 0;
			border-top: 1px solid #404040;
			margin-top: 8px;
		}
		.bag-actions {
			display: flex;
			gap: 10px;
			margin-top: 8px;
		}
		.checkout {
			flex: 1;
			background: #ededed;
			color: #0a0a0a;
			border: none;
			border-radius: 8px;
			font-size: 14px;
			font-weight: 600;
			padding: 12px;
			cursor: pointer;
			font-family: inherit;
		}
		.clear {
			background: transparent;
			border: 1px solid #404040;
			color: #a1a1a1;
			border-radius: 8px;
			font-size: 14px;
			padding: 12px 18px;
			cursor: pointer;
			font-family: inherit;
		}
		.empty {
			border: 1px dashed #404040;
			border-radius: 10px;
			padding: 28px;
			text-align: center;
			font-size: 14px;
			color: #888888;
		}
		.done {
			text-align: center;
			padding: 16px 0;
		}
		.done h3 {
			font-size: 20px;
			margin-bottom: 8px;
		}
		.done p {
			font-size: 14px;
			color: #a1a1a1;
			margin-bottom: 20px;
		}
		.foot {
			text-align: center;
			margin-top: 64px;
			font-size: 13px;
			color: #666666;
		}
		@media (max-width: 860px) {
			.grid { grid-template-columns: 1fr; }
			.hero h1 { font-size: 34px; }
		}
	}
	ui {
		<div class="page">
			<div class="topbar">
				<div class="topbar-inner">
					<span class="brand">Monochrome</span>
					<span class="bag">Bag · {computed.count}</span>
				</div>
			</div>
			<div class="wrap">
				<header class="hero">
					<h1>Objects of desire</h1>
					<p>Three perfect tools. Nothing else.</p>
				</header>
				<div class="grid">
					<ProductCard id="drift" name="Drift Keyboard" price="129" tag="Keyboards" desc="Gasket-mounted 75% board with silent linear switches." onAdd={() => methods.addToCart("drift", "Drift Keyboard", 129)} />
					<ProductCard id="aero" name="Aero Mouse" price="79" tag="Mice" desc="58-gram wireless mouse with 90-hour battery." onAdd={() => methods.addToCart("aero", "Aero Mouse", 79)} />
					<ProductCard id="mono" name="Mono Headphones" price="199" tag="Audio" desc="Closed-back studio sound with memory-foam cups." onAdd={() => methods.addToCart("mono", "Mono Headphones", 199)} />
				</div>
				<div class="bagbox">
					<h2>Your bag</h2>
					<p class="bagbox-sub">Adds and removes flush as one update via $batch.</p>
					$show(state.cart.length === 0 && !state.ordered) {
						<div class="empty">Your bag is empty. Add something beautiful.</div>
					}
					$show(state.cart.length > 0) {
						<div>
							$each(state.cart, (item) => {
								<div class="line">
									<span>{item.name}</span>
									<span>${item.price} <button @click={() => methods.removeFromCart(item.id, item.price)}>Remove</button></span>
								</div>
							})
							<div class="total"><span>Total</span><span>${state.total}</span></div>
							<div class="bag-actions">
								<button class="checkout" @click={methods.checkout}>Checkout</button>
								<button class="clear" @click={methods.clearCart}>Clear</button>
							</div>
						</div>
					}
					$show(state.ordered) {
						<div class="done">
							<h3>Order placed!</h3>
							<p>Confirmation #MB-2026 is on its way. Thank you for shopping small.</p>
							<button class="clear" @click={methods.clearCart}>Keep browsing</button>
						</div>
					}
				</div>
				<p class="foot">© 2026 Monochrome · Built with TardisJS blueprints</p>
			</div>
		</div>
	}
}
