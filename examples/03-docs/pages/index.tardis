blueprint Home {
	state {
		q: string = ""
	}
	computed {
		visible: ("install setup node npm requirements".includes(state.q) ? 1 : 0) + ("quick start counter first app".includes(state.q) ? 1 : 0) + ("blueprint sections props state computed methods events style ui script".includes(state.q) ? 1 : 0) + ("reactivity proxy update toggle batch computed".includes(state.q) ? 1 : 0) + ("routing pages dynamic params navigate".includes(state.q) ? 1 : 0) + ("cli dev build preview init config".includes(state.q) ? 1 : 0)
	}
	methods {
		setQ: (e) => $update(state.q, e.target.value.toLowerCase())
		clear: () => $update(state.q, "")
	}
	style {
		.page {
			background: #0a0a0a;
			color: #ededed;
			min-height: 100vh;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}
		.layout {
			max-width: 1080px;
			margin: 0 auto;
			padding: 0 24px 96px;
			display: grid;
			grid-template-columns: 240px 1fr;
			gap: 40px;
		}
		.top {
			max-width: 1080px;
			margin: 0 auto;
			padding: 48px 24px 8px;
		}
		.top-name {
			font-size: 13px;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: #3291ff;
			margin-bottom: 10px;
		}
		.top h1 {
			font-size: 36px;
			font-weight: 800;
			letter-spacing: -0.025em;
		}
		.side {
			position: sticky;
			top: 24px;
			align-self: start;
		}
		.search {
			width: 100%;
			background: #111111;
			border: 1px solid #404040;
			border-radius: 8px;
			color: #ededed;
			font-size: 13px;
			padding: 9px 12px;
			font-family: inherit;
			margin-bottom: 6px;
		}
		.count {
			font-size: 12px;
			color: #666666;
			margin-bottom: 14px;
		}
		.count button {
			background: none;
			border: none;
			color: #3291ff;
			font-size: 12px;
			cursor: pointer;
			padding: 0;
			font-family: inherit;
		}
		.nav a {
			display: block;
			font-size: 14px;
			color: #a1a1a1;
			padding: 7px 10px;
			border-radius: 6px;
		}
		.nav a:hover {
			color: #ededed;
			background: #1a1a1a;
			text-decoration: none;
		}
		.doc h2 {
			font-size: 26px;
			font-weight: 800;
			letter-spacing: -0.02em;
			margin: 40px 0 12px;
		}
		.doc h2:first-child {
			margin-top: 0;
		}
		.doc p {
			font-size: 15.5px;
			line-height: 1.7;
			color: #c9c9c9;
			margin-bottom: 14px;
		}
		.doc p strong {
			color: #ededed;
		}
		.doc pre {
			background: #111111;
			border: 1px solid #262626;
			border-radius: 10px;
			padding: 16px 18px;
			font-size: 13px;
			line-height: 1.65;
			overflow-x: auto;
			margin-bottom: 18px;
			font-family: 'JetBrains Mono', monospace;
			color: #ededed;
			white-space: pre-wrap;
		}
		.doc ul {
			margin: 0 0 16px 20px;
			padding: 0;
		}
		.doc li {
			font-size: 15px;
			color: #c9c9c9;
			margin-bottom: 6px;
		}
		.empty {
			border: 1px dashed #404040;
			border-radius: 10px;
			padding: 32px;
			text-align: center;
			font-size: 14px;
			color: #888888;
			margin-top: 24px;
		}
		@media (max-width: 820px) {
			.layout { grid-template-columns: 1fr; }
			.side { position: static; }
		}
	}
	ui {
		<div class="page">
			<div class="top">
				<div class="top-name">Fieldguide</div>
				<h1>TardisJS in six sections</h1>
			</div>
			<div class="layout">
				<aside class="side">
					<input class="search" value={state.q} @input={(e) => $update(state.q, e.target.value.toLowerCase())} placeholder="Filter sections…" />
					<p class="count">{computed.visible} of 6 sections <button @click={methods.clear}>clear</button></p>
					<nav class="nav">
						$each([{id:"install",label:"Installation"},{id:"quickstart",label:"Quick start"},{id:"blueprint",label:"Blueprint anatomy"},{id:"reactivity",label:"State and reactivity"},{id:"routing",label:"Routing"},{id:"cli",label:"CLI reference"}], (s) => {
							<a href={"#" + s.id}>{s.label}</a>
						})
					</nav>
				</aside>
				<div class="doc">
					$show(state.q === "" || "install setup node npm requirements".includes(state.q)) {
						<div id="install">
							<h2>Installation</h2>
							<p>You need <strong>Node.js 18+</strong> and a package manager. Scaffold a project, install, and start the dev server:</p>
							<pre>npx create-tardis-app my-app
cd my-app
npm install
npm run dev</pre>
							<p>Prefer an existing folder? Initialize in place with <strong>tardis init</strong> instead. The dev server watches your files and reloads the browser on save.</p>
						</div>
					}
					$show(state.q === "" || "quick start counter first app".includes(state.q)) {
						<div id="quickstart">
							<h2>Quick start</h2>
							<p>Every app starts from a page. Create <strong>pages/index.tardis</strong> with a blueprint: state for data, methods for behavior, ui for markup.</p>
							<pre>blueprint Home &#123;
  state &#123;
    count: number = 0
  &#125;
  methods &#123;
    increment: () =&#62; $update(state.count, state.count + 1)
  &#125;
  ui &#123;
    &#60;button @click=&#123;methods.increment&#125;&#62;&#123;state.count&#125;&#60;/button&#62;
  &#125;
&#125;</pre>
							<p>Clicking the button writes through <strong>$update</strong>, and only the bindings that read <strong>count</strong> re-render.</p>
						</div>
					}
					$show(state.q === "" || "blueprint sections props state computed methods events style ui script".includes(state.q)) {
						<div id="blueprint">
							<h2>Blueprint anatomy</h2>
							<p>A blueprint holds up to eight sections. Only <strong>ui</strong> is required:</p>
							<pre>props · typed inputs with defaults
state · reactive fields
computed · derived values
methods · arrow-function handlers
events · onMount / onUpdate / onDestroy
style · tokens, CSS, or raw stylesheet
ui · template (required)
script · DOM escape hatch</pre>
							<ul>
								<li>Pages usually omit <strong>props</strong>.</li>
								<li>Leaf components often omit <strong>state</strong>.</li>
								<li>Sections may appear in any order; output is deterministic.</li>
							</ul>
						</div>
					}
					$show(state.q === "" || "reactivity proxy update toggle batch computed".includes(state.q)) {
						<div id="reactivity">
							<h2>State and reactivity</h2>
							<p>State is a <strong>Proxy</strong>. Reads inside bindings register dependencies; writes re-run exactly those dependents. Updates are synchronous and ordered.</p>
							<pre>$update(state.count, 42)
$toggle(state.open)
$reset(state, &#123; count: 0 &#125;)
$batch(() =&#62; &#123;
  $update(state.a, 1)
  $update(state.b, 2)
&#125;)</pre>
							<p>Prefer <strong>computed</strong> over mirrored state, and assign new arrays instead of mutating in place.</p>
						</div>
					}
					$show(state.q === "" || "routing pages dynamic params navigate".includes(state.q)) {
						<div id="routing">
							<h2>Routing</h2>
							<p>Files under <strong>pages/</strong> become routes. Brackets mark dynamic segments, readable via <strong>$params</strong>.</p>
							<pre>pages/index.tardis → /
pages/about.tardis → /about
pages/blog/[id].tardis → /blog/:id</pre>
							<p>Navigate with <strong>$navigate(path)</strong>, or go back and forward with <strong>$back()</strong> and <strong>$forward()</strong>. Internal links are intercepted automatically.</p>
						</div>
					}
					$show(state.q === "" || "cli dev build preview init config".includes(state.q)) {
						<div id="cli">
							<h2>CLI reference</h2>
							<pre>tardis init     scaffold current directory
tardis dev      dev server + reload (:3000)
tardis build    production build → dist/
tardis preview  serve dist/ (:4000)</pre>
							<p>Configure via <strong>tardis.config.js</strong>: pages and components directories, output dir, port, title, head tags, and static directory.</p>
						</div>
					}
					$show(state.q !== "" && computed.visible === 0) {
						<div class="empty">No sections match "{state.q}". Try "routing" or "cli".</div>
					}
				</div>
			</div>
		</div>
	}
}
