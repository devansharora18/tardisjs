blueprint Home {
	state {
		tracks: array = []
		q: string = ""
		sortKey: string = "none"
		sortDir: string = "asc"
	}
	computed {
		visible: state.sortKey === "title" ? state.tracks.filter((t) => t.title.toLowerCase().includes(state.q.toLowerCase())).slice().sort((a, b) => state.sortDir === "asc" ? a.title.localeCompare(b.title) : b.title.localeCompare(a.title)) : (state.sortKey === "secs" ? state.tracks.filter((t) => t.title.toLowerCase().includes(state.q.toLowerCase())).slice().sort((a, b) => state.sortDir === "asc" ? a.secs - b.secs : b.secs - a.secs) : state.tracks.filter((t) => t.title.toLowerCase().includes(state.q.toLowerCase())))
		count: computed.visible.length + " of " + state.tracks.length + " tracks"
	}
	methods {
		setSort: (key) => $batch(() => ($update(state.sortDir, state.sortKey === key ? (state.sortDir === "asc" ? "desc" : "asc") : "asc"), $update(state.sortKey, key)))
		setManual: () => $update(state.sortKey, "none")
		moveUp: (id) => $update(state.tracks, state.tracks.map((t, i) => t.id === id ? (i === 0 ? t : state.tracks[i - 1]) : (i + 1 < state.tracks.length && state.tracks[i + 1].id === id ? state.tracks[i + 1] : t)))
		moveDown: (id) => $update(state.tracks, state.tracks.map((t, i) => t.id === id ? (i === state.tracks.length - 1 ? t : state.tracks[i + 1]) : (i === 0 ? t : (state.tracks[i - 1].id === id ? state.tracks[i - 1] : t))))
		rotate: () => $update(state.tracks, state.tracks.length < 2 ? state.tracks : [...state.tracks.slice(1), state.tracks[0]])
		clearFilter: () => $update(state.q, "")
	}
	events {
		onMount: () => $update(state.tracks, [{ id: "t1", title: "Midnight Run", artist: "Glasswork", length: "3:24", secs: 204 }, { id: "t2", title: "Paper Planes", artist: "Foil", length: "4:02", secs: 242 }, { id: "t3", title: "Solar Drift", artist: "Aurora Line", length: "2:51", secs: 171 }, { id: "t4", title: "Neon Harbor", artist: "Cassette Club", length: "3:47", secs: 227 }, { id: "t5", title: "Low Orbit", artist: "Vantablack", length: "5:10", secs: 310 }])
	}
	style {
		.page {
			background: #0a0a0a;
			color: #ededed;
			min-height: 100vh;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}
		.wrap {
			max-width: 760px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}
		.hero {
			text-align: center;
			padding: 72px 0 8px;
		}
		.kicker {
			font-size: 13px;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: #3291ff;
			margin-bottom: 14px;
		}
		.hero h1 {
			font-size: 38px;
			font-weight: 800;
			letter-spacing: -0.03em;
			margin-bottom: 14px;
		}
		.hero p {
			font-size: 15px;
			color: #a1a1a1;
			line-height: 1.6;
		}
		.toolbar {
			margin-top: 40px;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 12px;
			padding: 20px 24px;
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		.filterrow {
			display: flex;
			gap: 8px;
		}
		.filterrow input {
			flex: 1;
			background: #0a0a0a;
			border: 1px solid #404040;
			border-radius: 8px;
			color: #ededed;
			font-size: 14px;
			padding: 10px 12px;
			font-family: inherit;
		}
		.filterrow button {
			background: transparent;
			color: #ededed;
			border: 1px solid #404040;
			border-radius: 8px;
			font-size: 13px;
			font-weight: 600;
			padding: 10px 14px;
			cursor: pointer;
			font-family: inherit;
		}
		.sortrow {
			display: flex;
			gap: 8px;
			align-items: center;
			flex-wrap: wrap;
		}
		.sortrow button {
			background: transparent;
			color: #a1a1a1;
			border: 1px solid #404040;
			border-radius: 6px;
			font-size: 12px;
			font-weight: 600;
			padding: 6px 12px;
			cursor: pointer;
			font-family: inherit;
		}
		.sortrow button.on {
			color: #ededed;
			border-color: #3291ff;
		}
		.count {
			font-size: 13px;
			color: #888888;
		}
		.list {
			margin-top: 16px;
			display: flex;
			flex-direction: column;
			gap: 8px;
		}
		.track {
			display: flex;
			align-items: center;
			gap: 12px;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 10px;
			padding: 14px 16px;
		}
		.pos {
			font-size: 12px;
			color: #666666;
			min-width: 18px;
		}
		.meta {
			flex: 1;
		}
		.meta h3 {
			font-size: 15px;
			font-weight: 700;
		}
		.meta p {
			font-size: 12px;
			color: #888888;
		}
		.moves {
			display: flex;
			gap: 6px;
		}
		.moves button {
			background: transparent;
			color: #a1a1a1;
			border: 1px solid #404040;
			border-radius: 6px;
			font-size: 12px;
			padding: 4px 10px;
			cursor: pointer;
			font-family: inherit;
		}
		.empty {
			margin-top: 16px;
			text-align: center;
			font-size: 14px;
			color: #888888;
			border: 1px dashed #404040;
			border-radius: 10px;
			padding: 24px;
		}
		.foot {
			text-align: center;
			margin-top: 64px;
			font-size: 13px;
			color: #666666;
		}
	}
	ui {
		<div class="page">
			<div class="wrap">
				<header class="hero">
					<div class="kicker">Order is state</div>
					<h1>Playlist manager</h1>
					<p>Reorder buttons rewrite the track array immutably. Rotate is a fixed deterministic rotation — deliberately not a random shuffle, so the order stays reproducible. Sorting is a view over the manual order.</p>
				</header>
				<div class="toolbar">
					<div class="filterrow">
						<input value={state.q} @input={(e) => $update(state.q, e.target.value)} placeholder="Filter by title…" />
						<button @click={methods.clearFilter}>Clear</button>
					</div>
					<div class="sortrow">
						<button class={state.sortKey === "none" ? "on" : ""} @click={methods.setManual}>Manual</button>
						<button class={state.sortKey === "title" ? "on" : ""} @click={() => methods.setSort("title")}>Title</button>
						<button class={state.sortKey === "secs" ? "on" : ""} @click={() => methods.setSort("secs")}>Duration</button>
						<button class="rotate" @click={methods.rotate}>Rotate ⟳</button>
					</div>
					<p class="count">{computed.count}</p>
				</div>
				<div class="list">
					$each(computed.visible, (t) => {
						<div class="track">
							<span class="pos">♪</span>
							<div class="meta"><h3>{t.title}</h3><p>{t.artist} · {t.length}</p></div>
							<div class="moves"><button class="up" @click={() => methods.moveUp(t.id)}>↑</button><button class="down" @click={() => methods.moveDown(t.id)}>↓</button></div>
						</div>
					})
				</div>
				$show(computed.visible.length === 0) {
					<div class="empty">No tracks match "{state.q}". Clear the filter to see the full list.</div>
				}
				<p class="foot">© 2026 Keyed Demo · Built with TardisJS blueprints</p>
			</div>
		</div>
	}
}
