blueprint Home {
	state {
		filter: string = "all"
		selected: string = ""
	}
	methods {
		setFilter: (f) => $update(state.filter, f)
		open: (id) => $update(state.selected, id)
		close: () => $update(state.selected, "")
	}
	style {
		.page {
			background: #0a0a0a;
			color: #ededed;
			min-height: 100vh;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}
		.wrap {
			max-width: 1080px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}
		.hero {
			padding: 72px 0 12px;
			max-width: 640px;
		}
		.hero-name {
			font-size: 13px;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: #3291ff;
			margin-bottom: 14px;
		}
		.hero h1 {
			font-size: 46px;
			font-weight: 800;
			letter-spacing: -0.03em;
			line-height: 1.1;
			margin-bottom: 14px;
		}
		.hero p {
			font-size: 17px;
			color: #a1a1a1;
			line-height: 1.6;
		}
		.filters {
			display: flex;
			gap: 8px;
			margin: 36px 0 24px;
		}
		.filters button {
			background: transparent;
			border: 1px solid #404040;
			color: #a1a1a1;
			border-radius: 999px;
			font-size: 13px;
			font-weight: 600;
			padding: 8px 18px;
			cursor: pointer;
			font-family: inherit;
		}
		.filters button.on {
			background: #ededed;
			border-color: #ededed;
			color: #0a0a0a;
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 16px;
		}
		.lightbox {
			position: fixed;
			inset: 0;
			z-index: 100;
			background: rgba(0, 0, 0, 0.72);
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 24px;
		}
		.case {
			background: #111111;
			border: 1px solid #404040;
			border-radius: 14px;
			max-width: 560px;
			width: 100%;
			padding: 36px;
		}
		.case-tag {
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 0.07em;
			text-transform: uppercase;
			color: #3291ff;
			margin-bottom: 10px;
		}
		.case h2 {
			font-size: 28px;
			font-weight: 800;
			letter-spacing: -0.02em;
			margin-bottom: 12px;
		}
		.case p {
			font-size: 15px;
			line-height: 1.7;
			color: #c9c9c9;
			margin-bottom: 12px;
		}
		.case-close {
			margin-top: 16px;
			background: #ededed;
			color: #0a0a0a;
			border: none;
			border-radius: 8px;
			font-size: 14px;
			font-weight: 600;
			padding: 10px 20px;
			cursor: pointer;
			font-family: inherit;
		}
		.about {
			margin-top: 72px;
			border-top: 1px solid #262626;
			padding-top: 40px;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 32px;
		}
		.about h2 {
			font-size: 24px;
			font-weight: 800;
			margin-bottom: 10px;
		}
		.about p {
			font-size: 15px;
			color: #a1a1a1;
			line-height: 1.7;
		}
		.foot {
			text-align: center;
			margin-top: 64px;
			font-size: 13px;
			color: #666666;
		}
		@media (max-width: 860px) {
			.grid { grid-template-columns: 1fr; }
			.about { grid-template-columns: 1fr; }
			.hero h1 { font-size: 34px; }
		}
	}
	ui {
		<div class="page">
			<div class="wrap">
				<header class="hero">
					<div class="hero-name">Mara Voss — Portfolio</div>
					<h1>Design that ships and sells.</h1>
					<p>Ten years across brand, web, and mobile. Selected work below — filter by discipline.</p>
				</header>
				<div class="filters">
					<button class={state.filter === "all" ? "on" : ""} @click={() => methods.setFilter("all")}>All</button>
					<button class={state.filter === "web" ? "on" : ""} @click={() => methods.setFilter("web")}>Web</button>
					<button class={state.filter === "brand" ? "on" : ""} @click={() => methods.setFilter("brand")}>Brand</button>
					<button class={state.filter === "mobile" ? "on" : ""} @click={() => methods.setFilter("mobile")}>Mobile</button>
				</div>
				<div class="grid">
					$show(state.filter === "all" || state.filter === "web") {
						<ProjectCard id="p1" title="Helios Marketing Site" category="Web" year="2026" thumb="thumb thumb-1" onOpen={() => methods.open("p1")} />
					}
					$show(state.filter === "all" || state.filter === "brand") {
						<ProjectCard id="p2" title="Vertex Identity" category="Brand" year="2025" thumb="thumb thumb-2" onOpen={() => methods.open("p2")} />
					}
					$show(state.filter === "all" || state.filter === "mobile") {
						<ProjectCard id="p3" title="Ledger App" category="Mobile" year="2025" thumb="thumb thumb-3" onOpen={() => methods.open("p3")} />
					}
					$show(state.filter === "all" || state.filter === "web") {
						<ProjectCard id="p4" title="Orbital Docs" category="Web" year="2024" thumb="thumb thumb-4" onOpen={() => methods.open("p4")} />
					}
					$show(state.filter === "all" || state.filter === "brand") {
						<ProjectCard id="p5" title="Lumen Rebrand" category="Brand" year="2024" thumb="thumb thumb-5" onOpen={() => methods.open("p5")} />
					}
					$show(state.filter === "all" || state.filter === "mobile") {
						<ProjectCard id="p6" title="Pulse Fitness" category="Mobile" year="2023" thumb="thumb thumb-6" onOpen={() => methods.open("p6")} />
					}
				</div>
				$show(state.selected !== "") {
					<div class="lightbox">
						<div class="case">
							$if(state.selected === "p1") {
								<div><div class="case-tag">Web · 2026</div><h2>Helios Marketing Site</h2><p>Full redesign and build: 40 pages, a CMS editors love, and a 96 Lighthouse score. Conversion up 40% in the first quarter.</p><p>Role: design direction, frontend build. Stack: design tokens, static output, edge hosting.</p></div>
							}
							$if(state.selected === "p2") {
								<div><div class="case-tag">Brand · 2025</div><h2>Vertex Identity</h2><p>Identity system for a dev-tools startup: wordmark, type scale, color tokens, and a 60-page guideline site the whole company actually uses.</p></div>
							}
							$if(state.selected === "p3") {
								<div><div class="case-tag">Mobile · 2025</div><h2>Ledger App</h2><p>Personal finance app from zero to App Store feature. 4.9 stars across 12k reviews; onboarding completion doubled after the redesign.</p></div>
							}
							$if(state.selected === "p4") {
								<div><div class="case-tag">Web · 2024</div><h2>Orbital Docs</h2><p>Documentation platform serving 2M monthly readers. Search, versioning, and dark mode — with a build that finishes before coffee cools.</p></div>
							}
							$if(state.selected === "p5") {
								<div><div class="case-tag">Brand · 2024</div><h2>Lumen Rebrand</h2><p>Post-Series-B rebrand: positioning, voice, and a launch site that carried the funding announcement to the front page.</p></div>
							}
							$if(state.selected === "p6") {
								<div><div class="case-tag">Mobile · 2023</div><h2>Pulse Fitness</h2><p>Workout tracking with an offline-first architecture. Retention up 3x after we cut the flow from nine screens to three.</p></div>
							}
							<button class="case-close" @click={methods.close}>Close</button>
						</div>
					</div>
				}
				<div class="about">
					<div>
						<h2>About Mara</h2>
						<p>Independent designer since 2016. Previously design lead at two startups you have heard of and one you have not.</p>
					</div>
					<div>
						<h2>Contact</h2>
						<p>Currently booking Q1 2027. hello@maravoss.design — replies within two days.</p>
					</div>
				</div>
				<p class="foot">© 2026 Mara Voss · Built with TardisJS blueprints</p>
			</div>
		</div>
	}
}
