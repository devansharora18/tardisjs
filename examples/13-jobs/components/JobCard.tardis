blueprint JobCard {
	props {
		id: string = ""
		title: string = ""
		dept: string = ""
		loc: string = ""
		salary: string = ""
	}
	style {
		.job {
			display: block;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 10px;
			padding: 22px 24px;
			transition: border-color 0.15s;
		}
		.job:hover {
			border-color: #3291ff;
			text-decoration: none;
		}
		.job h3 {
			font-size: 18px;
			font-weight: 800;
			color: #ededed;
			margin-bottom: 8px;
		}
		.tags {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.tags span {
			font-size: 12px;
			color: #a1a1a1;
			background: #1c1c1c;
			border: 1px solid #2e2e2e;
			border-radius: 999px;
			padding: 3px 11px;
		}
		.tags span.pay {
			color: #7ee787;
			background: #0e2a1a;
			border-color: #1f6b3a;
		}
	}
	ui {
		<a class="job" href={"/jobs/" + props.id}>
			<h3>{props.title}</h3>
			<div class="tags"><span>{props.dept}</span><span>{props.loc}</span><span class="pay">{props.salary}</span></div>
		</a>
	}
}
