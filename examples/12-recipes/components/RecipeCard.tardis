blueprint RecipeCard {
	props {
		slug: string = ""
		title: string = ""
		meta: string = ""
		desc: string = ""
	}
	style {
		.card {
			display: block;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 10px;
			padding: 24px;
			transition: border-color 0.15s;
		}
		.card:hover {
			border-color: #ffa657;
			text-decoration: none;
		}
		.card h3 {
			font-size: 19px;
			font-weight: 800;
			color: #ededed;
			margin-bottom: 4px;
		}
		.meta {
			font-size: 12.5px;
			color: #ffa657;
			font-weight: 600;
			margin-bottom: 10px;
		}
		.card p {
			font-size: 14px;
			color: #a1a1a1;
			line-height: 1.6;
		}
	}
	ui {
		<a class="card" href={"/recipes/" + props.slug}>
			<h3>{props.title}</h3>
			<div class="meta">{props.meta}</div>
			<p>{props.desc}</p>
		</a>
	}
}
