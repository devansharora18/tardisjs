blueprint ListingCard {
	props {
		id: string = ""
		title: string = ""
		price: string = ""
		meta: string = ""
		blurb: string = ""
	}
	style {
		.card {
			display: block;
			background: #111111;
			border: 1px solid #262626;
			border-radius: 10px;
			padding: 24px;
			transition: border-color 0.15s;
		}
		.card:hover {
			border-color: #7ee787;
			text-decoration: none;
		}
		.card h3 {
			font-size: 19px;
			font-weight: 800;
			color: #ededed;
			margin-bottom: 4px;
		}
		.price {
			font-size: 22px;
			font-weight: 800;
			color: #7ee787;
			margin: 8px 0;
		}
		.meta {
			font-size: 12.5px;
			color: #888888;
			margin-bottom: 10px;
		}
		.card p {
			font-size: 14px;
			color: #a1a1a1;
			line-height: 1.6;
		}
	}
	ui {
		<a class="card" href={"/property/" + props.id}>
			<h3>{props.title}</h3>
			<div class="price">{props.price}</div>
			<div class="meta">{props.meta}</div>
			<p>{props.blurb}</p>
		</a>
	}
}
