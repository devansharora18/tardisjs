blueprint StateComparison {
	style {
		.code-split {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 16px;
		}
		.code-block {
			background: var(--code-surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			overflow: hidden;
		}
		.code-block-header {
			display: flex;
			align-items: center;
			gap: 6px;
			padding: 11px 14px;
			background: var(--code-bg);
			border-bottom: 1px solid var(--border);
		}
		.dot { width: 10px; height: 10px; border-radius: 50%; }
		.dot-close { background: var(--dot-close); }
		.dot-min { background: var(--dot-minimize); }
		.dot-max { background: var(--dot-maximize); }
		.code-filename {
			margin-left: 8px;
			font-size: 12px;
			font-weight: 500;
			color: var(--text-muted);
		}
		.code-block pre {
			padding: 18px;
			font-size: 13px;
			line-height: 1.65;
			white-space: pre-wrap;
			word-wrap: break-word;
			color: var(--text);
		}
		.points {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 16px;
			margin-top: 20px;
		}
		.point {
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 20px;
			background: var(--surface);
		}
		.point h4 {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 14px;
			font-weight: 600;
			margin-bottom: 6px;
		}
		.point-icon { display: inline-flex; color: var(--accent); }
		.point p {
			font-size: 13px;
			color: var(--text-secondary);
			line-height: 1.6;
		}
	}
	ui {
		<section class="section" id="reactivity">
			<div class="container">
				<p class="section-label">Reactivity</p>
				<h2 class="section-title">State without the ceremony</h2>
				<p class="section-desc">Declare state, write update expressions, and the compiler wires the reactivity. No hooks, no dependency arrays, no stale closures.</p>
				<div class="code-split">
					<div class="code-block">
						<div class="code-block-header">
							<div class="dot dot-close" aria-hidden="true"></div>
							<div class="dot dot-min" aria-hidden="true"></div>
							<div class="dot dot-max" aria-hidden="true"></div>
							<span class="code-filename">todo.tardis</span>
						</div>
						<pre id="code-tardis-state"></pre>
					</div>
					<div class="code-block">
						<div class="code-block-header">
							<div class="dot dot-close" aria-hidden="true"></div>
							<div class="dot dot-min" aria-hidden="true"></div>
							<div class="dot dot-max" aria-hidden="true"></div>
							<span class="code-filename">TodoApp.jsx</span>
						</div>
						<pre id="code-react-state"></pre>
					</div>
				</div>
				<div class="points">
					<div class="point">
						<h4><span class="point-icon"></span>No useState boilerplate</h4>
						<p>Declare typed state fields. The compiler generates Proxy-based reactive objects — you write <code>state.count</code>, not <code>useState(0)</code>.</p>
					</div>
					<div class="point">
						<h4><span class="point-icon"></span>No dependency arrays</h4>
						<p>React asks you to list dependencies in <code>useEffect</code>, <code>useMemo</code>, and <code>useCallback</code>. tardisjs tracks them through Proxy traps.</p>
					</div>
					<div class="point">
						<h4><span class="point-icon"></span>No stale closures</h4>
						<p>Hooks capture values at render time, so callbacks can read old state. tardisjs always reads the current value through the Proxy.</p>
					</div>
					<div class="point">
						<h4><span class="point-icon"></span>Computed values are automatic</h4>
						<p>A computed field re-evaluates when its dependencies change — no <code>useMemo</code> array that can go stale.</p>
					</div>
				</div>
			</div>
		</section>
	}
	script {
		function highlight(code) {
			let h = code
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/"([^"]*)"/g, '<span class="syn-str">"$1"</span>')
			h = h.replace(/\b(blueprint|state|methods|computed|props|events|ui|script|style)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/\b(number|string|boolean|array|function)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/(\$update|\$toggle)\b/g, '<span class="syn-fn">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			h = h.replace(/(&lt;\/?)([\w]+)/g, '$1<span class="syn-tag">$2</span>')
			h = h.replace(/(@[\w]+)/g, '<span class="syn-attr">$1</span>')
			return h
		}

		function highlightJsx(code) {
			let h = code
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/"([^"]*)"/g, '<span class="syn-str">"$1"</span>')
			h = h.replace(/\b(const|let|var|function|return|import|from|export|default|if|else|new)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/\b(useState|useEffect|useMemo|useCallback|useRef|useReducer)\b/g, '<span class="syn-fn">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			h = h.replace(/(&lt;\/?)([\w]+)/g, '$1<span class="syn-tag">$2</span>')
			h = h.replace(/(onChange|onClick|onSubmit)/g, '<span class="syn-attr">$1</span>')
			return h
		}

		const tardisState = `blueprint TodoApp {
  state {
    items: array = []
    input: string = ""
  }
  computed {
    remaining: () => state.items.filter(
      t => !t.done
    ).length
  }
  methods {
    add: () => {
      $update(state.items, [
        ...state.items,
        { text: state.input, done: false }
      ])
      $update(state.input, "")
    }
    toggle: (i) =>
      $update(state.items[i].done,
        !state.items[i].done)
  }
  ui {
    <p>{computed.remaining} remaining</p>
    <input value={state.input}
      @input={methods.setInput} />
    <button @click={methods.add}>Add</button>
  }
}`

		const reactState = `function TodoApp() {
  const [items, setItems] = useState([])
  const [input, setInput] = useState("")

  const remaining = useMemo(
    () => items.filter(t => !t.done).length,
    [items]  // forget this and it breaks
  )

  function add() {
    setItems(prev => [
      ...prev,
      { text: input, done: false }
    ])
    setInput("")
  }

  function toggle(i) {
    setItems(prev => prev.map(
      (t, idx) => idx === i
        ? { ...t, done: !t.done }
        : t
    ))
  }

  return (
    <>
      <p>{remaining} remaining</p>
      <input value={input}
        onChange={e => setInput(
          e.target.value
        )} />
      <button onClick={add}>Add</button>
    </>
  )
}`

		{<pre id="code-tardis-state"></pre>}.innerHTML = highlight(tardisState)
		{<pre id="code-react-state"></pre>}.innerHTML = highlightJsx(reactState)

		const CHECK = '<svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
		$el.querySelectorAll('.point-icon').forEach(el => { el.innerHTML = CHECK })
	}
}
