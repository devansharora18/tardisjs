blueprint Hero {
	style {
		.hero {
			position: relative;
			overflow: hidden;
			padding: clamp(48px, 6vw, 72px) 0 clamp(40px, 5vw, 56px);
		}
		.hero::before {
			content: "";
			position: absolute;
			inset: -40% 0 auto;
			height: 520px;
			background: radial-gradient(ellipse 55% 60% at 50% 0%, var(--accent-light), transparent 70%);
			pointer-events: none;
		}
		.hero-grid {
			position: relative;
			display: grid;
			grid-template-columns: 1.1fr 0.9fr;
			gap: 48px;
			align-items: start;
		}
		.hero-badge {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			color: var(--text-secondary);
			background: var(--surface);
			padding: 6px 12px;
			border-radius: 999px;
			border: 1px solid var(--border);
			margin-bottom: 22px;
		}
		.hero-badge::before {
			content: "";
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: var(--success);
			box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 22%, transparent);
		}
		.hero-sub {
			font-size: 16px;
			color: var(--text-secondary);
			max-width: 52ch;
			margin-bottom: 26px;
			line-height: 1.65;
		}
		.hero-sub code,
		.hero-chips code {
			font-family: 'Geist Mono', monospace;
			font-size: 13px;
			color: var(--text);
			background: var(--code-bg);
			border: 1px solid var(--border);
			border-radius: 5px;
			padding: 1px 6px;
		}
		.hero-actions {
			display: flex;
			gap: 10px;
			align-items: center;
			flex-wrap: wrap;
			margin-bottom: 20px;
		}
		.btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-size: 14px;
			font-weight: 500;
			padding: 10px 20px;
			border-radius: 999px;
			border: 1px solid transparent;
			cursor: pointer;
			transition: background 0.15s, border-color 0.15s, opacity 0.15s;
		}
		.btn-primary { background: var(--text); color: var(--bg); }
		.btn-primary:hover { opacity: 0.88; text-decoration: none; color: var(--bg); }
		.btn-secondary { background: transparent; color: var(--text); border-color: var(--border); }
		.btn-secondary:hover { border-color: var(--border-strong); background: var(--surface); text-decoration: none; }
		.hero-chips {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
		}
		.hero-side { position: sticky; top: 76px; }
		.code-preview {
			background: var(--code-surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			overflow: hidden;
			box-shadow: var(--shadow-md);
		}
		.code-preview-bar {
			display: flex;
			align-items: center;
			gap: 6px;
			padding: 11px 14px;
			background: var(--code-bg);
			border-bottom: 1px solid var(--border);
		}
		.dot { width: 10px; height: 10px; border-radius: 50%; }
		.dot-close { background: var(--dot-close); }
		.dot-min { background: var(--dot-minimize); }
		.dot-max { background: var(--dot-maximize); }
		.code-filename {
			margin-left: 8px;
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		.code-preview pre {
			padding: 16px 18px;
			font-size: 12.5px;
			line-height: 1.65;
			white-space: pre-wrap;
			word-wrap: break-word;
			color: var(--text);
		}
		.hero-stats {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 10px;
			margin-top: 12px;
		}
		@media (max-width: 900px) {
			.hero-grid { grid-template-columns: 1fr; gap: 32px; }
			.hero-side { position: static; }
		}
	}
	ui {
		<section class="hero">
			<div class="container hero-grid">
				<div class="hero-copy">
					<div class="hero-badge">Compiler-driven · no virtual DOM</div>
					<h1 class="headline">Write UI as blueprints.<br/><span class="muted">Ship plain JavaScript.</span></h1>
					<p class="hero-sub">TardisJS compiles <code>.tardis</code> blueprints through lex, parse, and compile into direct DOM code plus a small runtime. Reactivity is Proxy-based and field-level — no diff, no scheduler, no stale closures.</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="#get-started">Get started</a>
						<a class="btn btn-secondary" href="#benchmarks">See benchmarks</a>
					</div>
					<div class="hero-chips">
						<span class="chip">.tardis blueprints</span>
						<span class="chip">lex → parse → compile</span>
						<span class="chip">proxy reactivity</span>
						<span class="chip">file-based routing</span>
					</div>
				</div>
				<div class="hero-side">
					<div class="code-preview">
						<div class="code-preview-bar">
							<div class="dot dot-close" aria-hidden="true"></div>
							<div class="dot dot-min" aria-hidden="true"></div>
							<div class="dot dot-max" aria-hidden="true"></div>
							<span class="code-filename">counter.tardis</span>
						</div>
						<pre id="hero-code"></pre>
					</div>
					<div class="hero-stats">
						<div class="stat-card"><b id="stat-gzip">—</b><span>runtime gzip</span></div>
						<div class="stat-card"><b>0</b><span>virtual nodes</span></div>
						<div class="stat-card"><b>3</b><span>compiler stages</span></div>
					</div>
				</div>
			</div>
		</section>
	}
	script {
		function highlight(code) {
			let h = code
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/"([^"]*)"/g, '<span class="syn-str">"$1"</span>')
			h = h.replace(/\b(blueprint|state|methods|computed|props|events|ui|script|style)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/\b(number|string|boolean|array|function)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/(\$update|\$toggle)\b/g, '<span class="syn-fn">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			h = h.replace(/(&lt;\/?)([\w]+)/g, '$1<span class="syn-tag">$2</span>')
			h = h.replace(/(@[\w]+)/g, '<span class="syn-attr">$1</span>')
			return h
		}

		const code = `blueprint Counter {
  state {
    count: number = 0
  }
  methods {
    increment: () =>
      $update(state.count, state.count + 1)
  }
  ui {
    <div>
      <p>{state.count}</p>
      <button @click={methods.increment}>
        +1
      </button>
    </div>
  }
}`
		{<pre id="hero-code"></pre>}.innerHTML = highlight(code)

		const bench = window.__TARDIS_BENCH
		if (bench) {
			const tardis = bench.bundle.find(b => b.name === 'tardisjs')
			if (tardis && tardis.gzip) {
				{<b id="stat-gzip"></b>}.textContent = (tardis.gzip / 1024).toFixed(1) + 'KB'
			}
		}
	}
}
