blueprint ComparisonTable {
	style {
		.cmp-wrap {
			overflow-x: auto;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			background: var(--surface);
		}
		table.cmp {
			width: 100%;
			border-collapse: collapse;
			min-width: 620px;
			font-size: 14px;
		}
		table.cmp th,
		table.cmp td {
			text-align: left;
			padding: 14px 18px;
			border-bottom: 1px solid var(--border);
			vertical-align: middle;
		}
		table.cmp thead th {
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		table.cmp thead th.is-tardis {
			color: var(--accent);
		}
		table.cmp tbody tr:last-child td {
			border-bottom: none;
		}
		table.cmp tbody th {
			font-weight: 500;
			color: var(--text-secondary);
			white-space: nowrap;
		}
		table.cmp td.is-tardis {
			background: color-mix(in srgb, var(--accent) 7%, transparent);
			color: var(--text);
		}
		table.cmp td {
			color: var(--text-secondary);
		}
		.mark {
			display: inline-flex;
			align-items: center;
			gap: 8px;
		}
		.mark-yes { color: var(--success); }
		.mark-no { color: var(--text-muted); }
		.mark svg { display: block; }
		.dots {
			display: inline-flex;
			gap: 4px;
		}
		.dots i {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--border-strong);
		}
		.dots i.on { background: var(--accent); }
		.size-bar {
			display: flex;
			align-items: center;
			gap: 10px;
		}
		.size-bar .track {
			flex: 1;
			min-width: 60px;
			height: 8px;
			border-radius: 4px;
			background: var(--border);
			overflow: hidden;
		}
		.size-bar .fill {
			height: 100%;
			border-radius: 4px;
		}
		.size-bar .val {
			font-size: 12px;
			font-variant-numeric: tabular-nums;
			color: var(--text-secondary);
			min-width: 46px;
		}
		.take {
			margin-top: 20px;
			font-size: 13px;
			color: var(--text-muted);
			line-height: 1.6;
			max-width: 760px;
		}
	}
	ui {
		<section class="section section-alt" id="comparison">
			<div class="container">
				<p class="section-label">Comparison</p>
				<h2 class="section-title">TardisJS in context</h2>
				<p class="section-desc">Different trade-offs, not a clear winner. Runtime size comes from real benchmark data; maturity ratings reflect ecosystem age.</p>
				<div class="cmp-wrap">
					<table class="cmp">
						<thead>
							<tr>
								<th>Attribute</th>
								<th class="is-tardis">tardisjs</th>
								<th>Vue</th>
								<th>React</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<th>Rendering</th>
								<td class="is-tardis">Compiled bindings</td>
								<td>Virtual DOM</td>
								<td>Virtual DOM</td>
							</tr>
							<tr>
								<th>Reactivity</th>
								<td class="is-tardis">Proxy, field-level</td>
								<td>Proxy + scheduler</td>
								<td>Hooks + scheduler</td>
							</tr>
							<tr>
								<th>Runtime (gzip)</th>
								<td class="is-tardis"><span class="size-bar" data-size="tardisjs"></span></td>
								<td><span class="size-bar" data-size="Vue"></span></td>
								<td><span class="size-bar" data-size="React"></span></td>
							</tr>
							<tr>
								<th>Server rendering</th>
								<td class="is-tardis"><span class="mark mark-no"></span></td>
								<td><span class="mark mark-yes"></span></td>
								<td><span class="mark mark-yes"></span></td>
							</tr>
							<tr>
								<th>Devtools</th>
								<td class="is-tardis"><span class="dots" data-level="1"></span></td>
								<td><span class="dots" data-level="3"></span></td>
								<td><span class="dots" data-level="3"></span></td>
							</tr>
							<tr>
								<th>Ecosystem</th>
								<td class="is-tardis"><span class="dots" data-level="1"></span></td>
								<td><span class="dots" data-level="3"></span></td>
								<td><span class="dots" data-level="3"></span></td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="take">If you need SSR, mature tooling, or a large hiring pool today, React or Vue are the safer choice. TardisJS is worth a look if you want to inspect generated output and keep the runtime surface tiny.</p>
			</div>
		</section>
	}
	script {
		const CHECK = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
		const DASH = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>'

		$el.querySelectorAll('.mark-yes').forEach(el => { el.innerHTML = CHECK })
		$el.querySelectorAll('.mark-no').forEach(el => { el.innerHTML = DASH })
		$el.querySelectorAll('.dots').forEach(el => {
			const level = Number(el.getAttribute('data-level') || 0)
			let html = ''
			for (let i = 0; i < 3; i++) html += '<i class="' + (i < level ? 'on' : '') + '"></i>'
			el.innerHTML = html
		})

		const bench = window.__TARDIS_BENCH
		if (bench) {
			const COLORS = { tardisjs: '#3291ff', Vue: '#41b883', React: '#61dafb' }
			const sizes = {}
			bench.bundle.forEach(b => { sizes[b.name] = b.gzip || 0 })
			const max = Math.max.apply(null, Object.keys(sizes).map(k => sizes[k])) || 1
			$el.querySelectorAll('.size-bar').forEach(el => {
				const k = el.getAttribute('data-size')
				const v = sizes[k] || 0
				const pct = Math.max(6, (v / max) * 100)
				el.innerHTML =
					'<span class="track"><span class="fill" style="width:' + pct.toFixed(1) + '%;background:' + (COLORS[k] || '#888') + '"></span></span>' +
					'<span class="val">' + (v / 1024).toFixed(1) + 'KB</span>'
			})
		}
	}
}
