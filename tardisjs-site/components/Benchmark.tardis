blueprint Benchmark {
	style {
		.bench-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 20px;
		}
		.bench-card {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 22px;
		}
		.bench-card h3 {
			font-size: 15px;
			font-weight: 600;
			margin-bottom: 2px;
		}
		.bench-card .bench-unit {
			font-size: 12px;
			color: var(--text-muted);
			margin-bottom: 18px;
		}
		.bench-svg {
			width: 100%;
			height: auto;
			display: block;
			overflow: visible;
		}
		.bench-note {
			margin-top: 20px;
			font-size: 12px;
			color: var(--text-muted);
			line-height: 1.6;
			max-width: 720px;
		}
		.arch-figure {
			margin-top: 44px;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			background: var(--surface);
			padding: 24px;
			overflow-x: auto;
		}
		.arch-figure svg {
			display: block;
			width: 100%;
			min-width: 560px;
			height: auto;
		}
	}
	ui {
		<section class="section" id="benchmarks">
			<div class="container">
				<p class="section-label">Benchmarks</p>
				<h2 class="section-title">Measured against React and Vue</h2>
				<p class="section-desc">The same workload runs against each runtime: mount a 200-item list, then write one field 500 times. Numbers below are generated by <code>bench/run.mjs</code>, not hand-written.</p>
				<div class="bench-grid">
					<div class="bench-card">
						<h3>Initial mount</h3>
						<p class="bench-unit">200-item list, lower is better</p>
						<div id="chart-mount"></div>
					</div>
					<div class="bench-card">
						<h3>Field updates</h3>
						<p class="bench-unit">500 updates, lower is better</p>
						<div id="chart-update"></div>
					</div>
					<div class="bench-card">
						<h3>Bundle size</h3>
						<p class="bench-unit">gzip bytes, runtime only</p>
						<div id="chart-bundle"></div>
					</div>
				</div>
				<p class="bench-note" id="bench-note-out"></p>
				<div class="arch-figure">
					<div id="arch-out"></div>
				</div>
			</div>
		</section>
	}
	script {
		const data = window.__TARDIS_BENCH
		const COLORS = { tardisjs: '#3291ff', Vue: '#41b883', React: '#61dafb' }

		function barChart(rows, unit) {
			const max = Math.max.apply(null, rows.map(r => r.value)) || 1
			const labelW = 72
			const trackW = 300
			const rowH = 46
			const H = rows.length * rowH + 6
			let svg = '<svg class="bench-svg" viewBox="0 0 ' + (labelW + trackW + 76) + ' ' + H + '" role="img">'
			rows.forEach((r, i) => {
				const y = i * rowH + 8
				const w = Math.max(6, (r.value / max) * trackW)
				const color = COLORS[r.label] || '#888'
				const value = unit === 'bytes' ? (r.value / 1024).toFixed(1) + ' KB' : r.value.toFixed(0) + ' ms'
				svg += '<text x="0" y="' + (y + 20) + '" fill="var(--text-secondary)" font-size="13">' + r.label + '</text>'
				svg += '<rect x="' + labelW + '" y="' + (y + 4) + '" width="' + trackW + '" height="18" rx="4" fill="var(--border)" opacity="0.5"/>'
				svg += '<rect x="' + labelW + '" y="' + (y + 4) + '" width="' + w.toFixed(1) + '" height="18" rx="4" fill="' + color + '"/>'
				svg += '<text x="' + (labelW + trackW + 10) + '" y="' + (y + 18) + '" fill="var(--text)" font-size="13" font-weight="600">' + value + '</text>'
			})
			svg += '</svg>'
			return svg
		}

		function archDiagram() {
			const cell = 'fill="var(--surface)" stroke="var(--border)"'
			return '<svg viewBox="0 0 900 240" role="img" aria-label="Virtual DOM diffing versus compiled bindings">' +
				'<text x="0" y="20" fill="var(--text-secondary)" font-size="13" font-weight="600">React / Vue — re-render + diff</text>' +
				'<rect x="0" y="40" width="150" height="48" rx="8" ' + cell + '/>' +
				'<text x="75" y="69" text-anchor="middle" fill="var(--text)" font-size="13">state change</text>' +
				'<rect x="180" y="40" width="150" height="48" rx="8" ' + cell + '/>' +
				'<text x="255" y="69" text-anchor="middle" fill="var(--text)" font-size="13">re-render tree</text>' +
				'<rect x="360" y="40" width="150" height="48" rx="8" ' + cell + '/>' +
				'<text x="435" y="69" text-anchor="middle" fill="var(--text)" font-size="13">diff old vs new</text>' +
				'<rect x="540" y="40" width="150" height="48" rx="8" ' + cell + '/>' +
				'<text x="615" y="69" text-anchor="middle" fill="var(--text)" font-size="13">patch DOM</text>' +
				'<path d="M150 64 H180 M330 64 H360 M510 64 H540" stroke="var(--border-strong)" stroke-width="2"/>' +
				'<text x="0" y="150" fill="var(--text-secondary)" font-size="13" font-weight="600">tardisjs — proxy trap + direct write</text>' +
				'<rect x="0" y="170" width="150" height="48" rx="8" fill="var(--accent-light)" stroke="var(--accent)"/>' +
				'<text x="75" y="199" text-anchor="middle" fill="var(--text)" font-size="13">state change</text>' +
				'<rect x="180" y="170" width="150" height="48" rx="8" fill="var(--accent-light)" stroke="var(--accent)"/>' +
				'<text x="255" y="199" text-anchor="middle" fill="var(--text)" font-size="13">proxy trap fires</text>' +
				'<rect x="360" y="170" width="150" height="48" rx="8" fill="var(--accent-light)" stroke="var(--accent)"/>' +
				'<text x="435" y="199" text-anchor="middle" fill="var(--text)" font-size="13">bound updater</text>' +
				'<rect x="540" y="170" width="150" height="48" rx="8" fill="var(--accent-light)" stroke="var(--accent)"/>' +
				'<text x="615" y="199" text-anchor="middle" fill="var(--text)" font-size="13">one DOM write</text>' +
				'<path d="M150 194 H180 M330 194 H360 M510 194 H540" stroke="var(--accent)" stroke-width="2"/>' +
				'</svg>'
		}

		if (!data) {
			{<p id="bench-note-out"></p>}.textContent = 'Benchmark data not found. Run `npm run bench` in bench/.'
		} else {
			const byName = {}
			data.runtimes.forEach(r => { byName[r.name] = r })
			const order = ['tardisjs', 'Vue', 'React']
			const mountRows = order.map(n => ({ label: n, value: byName[n].mountMs }))
			const updateRows = order.map(n => ({ label: n, value: byName[n].updateMs }))
			const bundleRows = order.map(n => ({ label: n, value: (data.bundle.find(b => b.name === n) || {}).gzip || 0 }))
			{<div id="chart-mount"></div>}.innerHTML = barChart(mountRows, 'ms')
			{<div id="chart-update"></div>}.innerHTML = barChart(updateRows, 'ms')
			{<div id="chart-bundle"></div>}.innerHTML = barChart(bundleRows, 'bytes')
			{<p id="bench-note-out"></p>}.textContent = data.environment + '. Workload: ' + data.listSize + '-item list, ' + data.updateCount + ' updates. Generated ' + data.generatedAt.slice(0, 10) + '.'
			{<div id="arch-out"></div>}.innerHTML = archDiagram()
		}
	}
}
