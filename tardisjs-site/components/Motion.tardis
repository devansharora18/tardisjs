blueprint Motion {
	ui {
		<div aria-hidden="true" style="display:none"></div>
	}
	script {
		if (window.__tardisMotion) return
		window.__tardisMotion = true
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
		if (window.Lenis) {
			const lenis = new window.Lenis({ lerp: 0.1 })
			window.__tardisLenis = lenis
			function raf(time) {
				lenis.raf(time)
				requestAnimationFrame(raf)
			}
			requestAnimationFrame(raf)
		}
		if (window.gsap && window.ScrollTrigger) {
			window.gsap.registerPlugin(window.ScrollTrigger)
			if (window.__tardisLenis) {
				window.__tardisLenis.on('scroll', window.ScrollTrigger.update)
			}
			const sections = Array.from(document.querySelectorAll('#app section')).slice(1)
			sections.forEach((el) => {
				window.gsap.from(el, {
					y: 24,
					opacity: 0,
					duration: 0.6,
					ease: 'power2.out',
					scrollTrigger: { trigger: el, start: 'top 88%', once: true }
				})
			})
		}
	}
}
