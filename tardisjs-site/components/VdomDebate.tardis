blueprint VdomDebate {
	style {
		.code-split {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 16px;
		}
		.code-block {
			background: var(--code-surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			overflow: hidden;
		}
		.code-block-header {
			display: flex;
			align-items: center;
			gap: 6px;
			padding: 11px 14px;
			background: var(--code-bg);
			border-bottom: 1px solid var(--border);
		}
		.dot { width: 10px; height: 10px; border-radius: 50%; }
		.dot-close { background: var(--dot-close); }
		.dot-min { background: var(--dot-minimize); }
		.dot-max { background: var(--dot-maximize); }
		.code-filename {
			margin-left: 8px;
			font-size: 12px;
			font-weight: 500;
			color: var(--text-muted);
		}
		.code-block pre {
			padding: 18px;
			font-size: 13px;
			line-height: 1.65;
			white-space: pre-wrap;
			word-wrap: break-word;
			color: var(--text);
		}
		.steps {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 16px;
			margin-top: 20px;
		}
		.step {
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 22px;
			background: var(--surface);
		}
		.step-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border-radius: var(--radius);
			border: 1px solid var(--border);
			background: var(--bg);
			color: var(--accent);
			margin-bottom: 14px;
		}
		.step h3 {
			font-size: 15px;
			font-weight: 600;
			margin-bottom: 6px;
		}
		.step p {
			font-size: 14px;
			color: var(--text-secondary);
			line-height: 1.6;
		}
	}
	ui {
		<section class="section" id="vdom">
			<div class="container">
				<div class="sec-head">
					<div>
						<p class="section-label">Architecture</p>
						<h2 class="headline">Virtual DOM vs compiled bindings.<br/><span class="muted">Both are valid.</span></h2>
					</div>
					<p class="sec-head-desc">TardisJS chooses compile-time binding maps and direct DOM writes to keep runtime behavior straightforward.</p>
				</div>
				<div class="code-split">
					<div class="code-block">
						<div class="code-block-header">
							<div class="dot dot-close" aria-hidden="true"></div>
							<div class="dot dot-min" aria-hidden="true"></div>
							<div class="dot dot-max" aria-hidden="true"></div>
							<span class="code-filename">Virtual DOM (React)</span>
						</div>
						<pre id="code-vdom"></pre>
					</div>
					<div class="code-block">
						<div class="code-block-header">
							<div class="dot dot-close" aria-hidden="true"></div>
							<div class="dot dot-min" aria-hidden="true"></div>
							<div class="dot dot-max" aria-hidden="true"></div>
							<span class="code-filename">Direct binding (tardisjs)</span>
						</div>
						<pre id="code-direct"></pre>
					</div>
				</div>
				<div class="steps">
					<div class="step">
						<span class="step-icon" data-icon="layers"></span>
						<h3>Why VDOM exists</h3>
						<p>Virtual DOM makes updates declarative and portable across many component patterns. It also centralizes update scheduling.</p>
					</div>
					<div class="step">
						<span class="step-icon" data-icon="activity"></span>
						<h3>The cost</h3>
						<p>It pays runtime work per update: render functions run, trees are compared, and patches are applied.</p>
					</div>
					<div class="step">
						<span class="step-icon" data-icon="cpu"></span>
						<h3>Compiler alternative</h3>
						<p>TardisJS records dependencies during binding and updates by field. The trade-off is less abstraction and a smaller ecosystem.</p>
					</div>
				</div>
			</div>
		</section>
	}
	script {
		function highlight(code) {
			let h = code
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/\b(state)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			h = h.replace(/(textNode\.data|Proxy trap)/g, '<span class="syn-fn">$1</span>')
			return h
		}

		const vdomCode = `// On every state change:
1. Component function re-executes
2. New virtual tree is created
3. Old and new trees are diffed
4. Minimal DOM patches are applied

// Even for a single text change,
// React walks the entire subtree.`

		const directCode = `// On state.count change:
1. Proxy trap fires
2. Bound updater runs:
   textNode.data = state.count

// One state change = one DOM write.
// No tree. No diff. No scheduling.`

		{<pre id="code-vdom"></pre>}.innerHTML = highlight(vdomCode)
		{<pre id="code-direct"></pre>}.innerHTML = highlight(directCode)

		const ICONS = {
			layers: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
			activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
			cpu: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>'
		}
		$el.querySelectorAll('.step-icon').forEach(el => {
			const path = ICONS[el.getAttribute('data-icon')] || ''
			el.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + path + '</svg>'
		})
	}
}
