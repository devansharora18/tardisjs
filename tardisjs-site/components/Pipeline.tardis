blueprint Pipeline {
	style {
		.pipe-figure {
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			background: var(--surface);
			padding: 24px 12px;
			overflow-x: auto;
		}
		.pipe-figure svg {
			display: block;
			width: 100%;
			min-width: 660px;
			height: auto;
		}
		.steps {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 16px;
			margin-top: 20px;
		}
		.step {
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 22px;
			background: var(--surface);
		}
		.step-num {
			font-family: 'Geist Mono', monospace;
			font-size: 13px;
			font-weight: 500;
			color: var(--accent);
			margin-bottom: 12px;
		}
		.step h3 {
			font-size: 15px;
			font-weight: 600;
			margin-bottom: 6px;
		}
		.step p {
			font-size: 14px;
			color: var(--text-secondary);
			line-height: 1.6;
		}
	}
	ui {
		<section class="section section-alt" id="how-it-works">
			<div class="container">
				<div class="sec-head">
					<div>
						<p class="section-label">Pipeline</p>
						<h2 class="headline">Build-time does the work.<br/><span class="muted">Runtime just binds.</span></h2>
					</div>
					<p class="sec-head-desc">Five stages from source to browser. The compiler resolves structure; the runtime handles subscriptions, updates, and routing.</p>
				</div>
				<div class="pipe-figure">
					<div id="pipe-out"></div>
				</div>
				<div class="steps">
					<div class="step">
						<div class="step-num">01 — lex()</div>
						<h3>Tokenize</h3>
						<p>The lexer converts source into tokens for section keywords, literals, operators, and raw UI/script blocks.</p>
					</div>
					<div class="step">
						<div class="step-num">02 — parse()</div>
						<h3>Build the AST</h3>
						<p>The parser produces typed nodes: props, state, computed, methods, events, style metadata, and UI.</p>
					</div>
					<div class="step">
						<div class="step-num">03 — compile()</div>
						<h3>Emit JavaScript</h3>
						<p>The compiler creates DOM nodes, registers bindings, and wires events against the runtime API.</p>
					</div>
				</div>
			</div>
		</section>
	}
	script {
		const STAGES = [
			{ label: '.tardis', sub: 'source' },
			{ label: 'lex()', sub: 'tokens' },
			{ label: 'parse()', sub: 'AST' },
			{ label: 'compile()', sub: 'JavaScript' },
			{ label: 'browser', sub: 'runtime' }
		]
		const W = 920
		const nodeW = 150
		const nodeH = 64
		const gap = 40
		const y = 40
		const cy = y + nodeH / 2
		const startX = 5
		const centers = STAGES.map((_, i) => startX + i * (nodeW + gap) + nodeW / 2)
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

		let svg = '<svg viewBox="0 0 ' + W + ' 150" role="img" aria-label="Build pipeline: source through lex, parse, compile, to the browser runtime">'
		svg += '<line x1="' + centers[0] + '" y1="' + cy + '" x2="' + centers[centers.length - 1] + '" y2="' + cy + '" stroke="var(--border-strong)" stroke-width="2"/>'
		if (!reduce) {
			svg += '<circle r="4" fill="var(--accent)"><animateMotion dur="3.6s" repeatCount="indefinite" path="M' + centers[0] + ' ' + cy + ' H' + centers[centers.length - 1] + '"/></circle>'
		}
		STAGES.forEach((s, i) => {
			const x = startX + i * (nodeW + gap)
			const last = i === STAGES.length - 1
			const stroke = last ? 'var(--accent)' : 'var(--border)'
			const fill = last ? 'var(--accent-light)' : 'var(--surface)'
			svg += '<rect x="' + x + '" y="' + y + '" width="' + nodeW + '" height="' + nodeH + '" rx="10" fill="' + fill + '" stroke="' + stroke + '"/>'
			svg += '<text x="' + (x + nodeW / 2) + '" y="' + (cy - 2) + '" text-anchor="middle" fill="var(--text)" font-size="14" font-weight="600" font-family="Geist Mono, monospace">' + s.label + '</text>'
			svg += '<text x="' + (x + nodeW / 2) + '" y="' + (cy + 16) + '" text-anchor="middle" fill="var(--text-muted)" font-size="11">' + s.sub + '</text>'
		})
		svg += '</svg>'
		{<div id="pipe-out"></div>}.innerHTML = svg
	}
}
