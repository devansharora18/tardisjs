blueprint Docs {
	style {
		.docs-page {
			background: var(--bg);
			color: var(--text);
			min-height: 100vh;
		}
		.docs-shell {
			max-width: 1280px;
			margin: 0 auto;
			padding: 28px 24px 72px;
			display: grid;
			grid-template-columns: 236px minmax(0, 1fr) 210px;
			gap: 36px;
			align-items: start;
		}
		.docs-sidebar {
			position: sticky;
			top: 76px;
			max-height: calc(100vh - 96px);
			overflow-y: auto;
		}
		.docs-group { margin-bottom: 22px; }
		.docs-group-title {
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--text-muted);
			margin-bottom: 8px;
		}
		.docs-sidebar a {
			display: block;
			font-size: 13.5px;
			color: var(--text-secondary);
			padding: 5px 10px;
			border-radius: var(--radius-sm);
			border-left: 2px solid transparent;
		}
		.docs-sidebar a:hover {
			color: var(--text);
			background: var(--surface);
			text-decoration: none;
		}
		.docs-sidebar a.active {
			color: var(--text);
			background: var(--surface);
			border-left-color: var(--accent);
		}
		.docs-content { min-width: 0; }
		.docs-crumb {
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			color: var(--text-muted);
			margin-bottom: 14px;
		}
		.docs-crumb a { color: var(--text-muted); }
		.docs-crumb a:hover { color: var(--text); text-decoration: none; }
		.docs-head {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			border-bottom: 1px solid var(--border);
			padding-bottom: 16px;
			margin-bottom: 26px;
		}
		.docs-head h1 {
			font-size: clamp(28px, 3.4vw, 38px);
			font-weight: 800;
			letter-spacing: -0.03em;
			line-height: 1.05;
		}
		.docs-actions { display: flex; gap: 8px; }
		.docs-action {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			color: var(--text-secondary);
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			padding: 6px 10px;
			cursor: pointer;
		}
		.docs-action:hover { color: var(--text); border-color: var(--border-strong); }
		.docs-content h2 {
			font-size: 24px;
			font-weight: 700;
			letter-spacing: -0.02em;
			margin: 44px 0 12px;
			scroll-margin-top: 84px;
		}
		.docs-content h3 {
			font-size: 17px;
			font-weight: 600;
			margin: 26px 0 8px;
			scroll-margin-top: 84px;
		}
		.docs-content p,
		.docs-content li {
			color: var(--text-secondary);
			font-size: 15px;
			line-height: 1.7;
		}
		.docs-content p { margin-bottom: 12px; }
		.docs-content strong { color: var(--text); font-weight: 600; }
		.docs-content ul,
		.docs-content ol { padding-left: 20px; margin: 8px 0 14px; }
		.docs-content li + li { margin-top: 5px; }
		.docs-content :not(pre) > code {
			font-family: 'Geist Mono', monospace;
			font-size: 13px;
			color: var(--text);
			background: var(--code-bg);
			border: 1px solid var(--border);
			border-radius: 5px;
			padding: 1px 6px;
		}
		.docs-content a { color: var(--accent); }
		.codeblock {
			margin: 14px 0 18px;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			background: var(--code-bg);
			overflow: hidden;
		}
		.codeblock-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 8px 12px;
			border-bottom: 1px solid var(--border);
			background: var(--surface);
		}
		.codeblock-lang {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		.codeblock pre {
			padding: 14px 16px;
			overflow-x: auto;
			font-size: 13px;
			line-height: 1.65;
		}
		.codeblock pre code { color: var(--text); white-space: pre; }
		.copy-code {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			color: var(--text-muted);
			background: none;
			border: 1px solid var(--border);
			border-radius: 5px;
			padding: 3px 8px;
			cursor: pointer;
		}
		.copy-code:hover { color: var(--text); border-color: var(--border-strong); }
		.callout {
			display: flex;
			gap: 12px;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 14px 16px;
			margin: 16px 0;
			background: var(--surface);
		}
		.callout-icon { flex-shrink: 0; width: 20px; height: 20px; margin-top: 1px; }
		.callout-body { min-width: 0; }
		.callout-title { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
		.callout p { font-size: 14px; margin: 0; }
		.callout-note { border-left: 2px solid var(--accent); }
		.callout-note .callout-title,
		.callout-note .callout-icon { color: var(--accent); }
		.callout-tip { border-left: 2px solid var(--success); }
		.callout-tip .callout-title,
		.callout-tip .callout-icon { color: var(--success); }
		.callout-warning { border-left: 2px solid var(--warning); }
		.callout-warning .callout-title,
		.callout-warning .callout-icon { color: var(--warning); }
		.docs-table-wrap {
			overflow-x: auto;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			margin: 14px 0 18px;
		}
		table.docs-table { width: 100%; border-collapse: collapse; font-size: 14px; }
		table.docs-table th,
		table.docs-table td {
			text-align: left;
			padding: 10px 14px;
			border-bottom: 1px solid var(--border);
			vertical-align: top;
		}
		table.docs-table tbody tr:last-child td { border-bottom: none; }
		table.docs-table th {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		table.docs-table td { color: var(--text-secondary); }
		table.docs-table td:first-child {
			color: var(--text);
			font-family: 'Geist Mono', monospace;
			font-size: 13px;
			white-space: nowrap;
		}
		.steps { counter-reset: step; margin: 16px 0; }
		.step-row { position: relative; padding-left: 40px; padding-bottom: 20px; }
		.step-row::before {
			counter-increment: step;
			content: counter(step);
			position: absolute;
			left: 0;
			top: 0;
			width: 26px;
			height: 26px;
			border-radius: 50%;
			border: 1px solid var(--border);
			background: var(--surface);
			color: var(--text);
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			display: grid;
			place-items: center;
		}
		.step-row::after {
			content: "";
			position: absolute;
			left: 13px;
			top: 30px;
			bottom: 0;
			width: 1px;
			background: var(--border);
		}
		.step-row:last-child::after { display: none; }
		.step-row h3 { margin: 2px 0 4px; }
		.docs-pager {
			display: flex;
			justify-content: space-between;
			gap: 12px;
			margin-top: 48px;
			padding-top: 20px;
			border-top: 1px solid var(--border);
		}
		.docs-pager a {
			flex: 1;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 12px 16px;
			color: var(--text-secondary);
		}
		.docs-pager a:hover { border-color: var(--border-strong); text-decoration: none; }
		.docs-pager .dir {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--text-muted);
		}
		.docs-pager .label { display: block; margin-top: 3px; color: var(--text); font-size: 14px; }
		.docs-pager .next { text-align: right; }
		.docs-toc {
			position: sticky;
			top: 76px;
			max-height: calc(100vh - 96px);
			overflow-y: auto;
		}
		.docs-toc h3 {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--text-muted);
			margin-bottom: 10px;
		}
		.docs-toc a {
			display: block;
			font-size: 13px;
			color: var(--text-muted);
			padding: 4px 0 4px 10px;
			border-left: 2px solid transparent;
		}
		.docs-toc a:hover { color: var(--text); text-decoration: none; }
		.docs-toc a.active { color: var(--text); border-left-color: var(--accent); }
		@media (max-width: 1120px) {
			.docs-shell { grid-template-columns: 220px minmax(0, 1fr); }
			.docs-toc { display: none; }
		}
		@media (max-width: 860px) {
			.docs-shell { grid-template-columns: 1fr; gap: 20px; padding: 20px 18px 56px; }
			.docs-sidebar {
				position: static;
				max-height: none;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 14px;
				background: var(--surface);
			}
			.docs-group { margin-bottom: 14px; }
		}
	}
	ui {
		<div class="docs-page">
			<Navbar />
			<div class="docs-shell">
				<aside class="docs-sidebar" aria-label="Documentation">
					<div class="docs-group">
						<div class="docs-group-title"><span>Getting started</span><span class="count">3</span></div>
						<a href="#introduction">Introduction</a>
						<a href="#quickstart">Quick start</a>
						<a href="#structure">Project structure</a>
					</div>
					<div class="docs-group">
						<div class="docs-group-title"><span>Core concepts</span><span class="count">3</span></div>
						<a href="#blueprints">Blueprint syntax</a>
						<a href="#templating">UI &amp; templating</a>
						<a href="#reactivity">Reactivity</a>
					</div>
					<div class="docs-group">
						<div class="docs-group-title"><span>Reference</span><span class="count">6</span></div>
						<a href="#runtime">Runtime API</a>
						<a href="#router">Router</a>
						<a href="#selector">Selector</a>
						<a href="#styles">Styles</a>
						<a href="#events">Lifecycle events</a>
						<a href="#registry">Component registry</a>
					</div>
					<div class="docs-group">
						<div class="docs-group-title"><span>Tooling</span><span class="count">4</span></div>
						<a href="#cli">CLI</a>
						<a href="#config">Configuration</a>
						<a href="#compiler">Compiler pipeline</a>
						<a href="#errors">Errors</a>
					</div>
					<div class="docs-group">
						<div class="docs-group-title"><span>Guides</span><span class="count">4</span></div>
						<a href="#examples">Examples</a>
						<a href="#benchmarks">Benchmarks</a>
						<a href="#faq">FAQ</a>
						<a href="#contributing">Contributing</a>
					</div>
				</aside>

				<main class="docs-content">
					<nav class="docs-crumb"><a href="/">Docs</a> / Introduction</nav>
					<div class="docs-head">
						<h1 id="introduction">Introduction</h1>
						<div class="docs-actions">
							<button class="docs-action" id="copy-llm">Copy for LLM</button>
							<a class="docs-action" href="https://github.com/devansharora18/tardisjs" target="_blank" rel="noreferrer">Open</a>
						</div>
					</div>

					<p><strong>TardisJS</strong> is a compiler-driven frontend framework built around a blueprint DSL. It compiles <code>.tardis</code> files to plain JavaScript modules plus a small runtime (~7KB gzipped), using Proxy-based reactivity and direct DOM bindings — no virtual DOM, no reconciliation.</p>

					<div class="callout callout-note">
						<span class="callout-icon" data-icon="info"></span>
						<div class="callout-body">
							<div class="callout-title">Experimental</div>
							<p>TardisJS is blueprint-first by design and meant for teams who want explicit generated output and a small runtime surface. For SSR and a large ecosystem today, React or Vue remain safer choices.</p>
						</div>
					</div>

					<h2 id="quickstart">Quick start</h2>
					<p>Scaffold a project, install dependencies, and start the dev server:</p>
					<div class="codeblock" data-code="quickstart" data-lang="bash"></div>
					<p>Or initialize inside an existing directory:</p>
					<div class="codeblock" data-code="init" data-lang="bash"></div>

					<h2 id="structure">Project structure</h2>
					<p>A project is pages, components, static assets, and a config file:</p>
					<div class="codeblock" data-code="structure" data-lang="text"></div>
					<p>Routes come from the <code>pages/</code> directory — <code>pages/index.tardis</code> maps to <code>/</code> and <code>pages/blog/[id].tardis</code> maps to <code>/blog/:id</code>.</p>

					<h2 id="blueprints">Blueprint syntax</h2>
					<p>A <strong>blueprint</strong> is a named unit with optional sections. Only <code>ui</code> is required.</p>
					<div class="codeblock" data-code="blueprint" data-lang="tardis"></div>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Section</th><th>Purpose</th></tr></thead>
							<tbody>
								<tr><td>props</td><td>Typed component inputs with defaults.</td></tr>
								<tr><td>state</td><td>Reactive local state (Proxy-wrapped).</td></tr>
								<tr><td>computed</td><td>Derived values that re-evaluate from their dependencies.</td></tr>
								<tr><td>methods</td><td>Event handlers and logic (arrow functions).</td></tr>
								<tr><td>events</td><td>Lifecycle: onMount, onDestroy, onUpdate.</td></tr>
								<tr><td>style</td><td>Named class tokens, CSS, or raw stylesheet.</td></tr>
								<tr><td>ui</td><td>HTML-like template with reactive bindings. Required.</td></tr>
								<tr><td>script</td><td>Escape hatch for raw DOM access via $el.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="templating">UI &amp; templating</h2>
					<p>The <code>ui</code> block is HTML-like with reactive bindings. Text interpolates with braces, attributes accept expressions, and events bind with <code>@</code>.</p>
					<div class="codeblock" data-code="templating" data-lang="tardis"></div>
					<h3>Control flow</h3>
					<p>Conditionals and lists are runtime helpers used inside <code>ui</code>:</p>
					<div class="codeblock" data-code="controlflow" data-lang="tardis"></div>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Helper</th><th>Behavior</th></tr></thead>
							<tbody>
								<tr><td>$if(cond)</td><td>Mounts or removes the block when the condition changes.</td></tr>
								<tr><td>$each(list, fn)</td><td>Renders one node per item and re-renders when the list changes.</td></tr>
								<tr><td>$show(cond)</td><td>Keeps the node mounted and toggles display.</td></tr>
							</tbody>
						</table>
					</div>
					<div class="callout callout-warning">
						<span class="callout-icon" data-icon="warn"></span>
						<div class="callout-body">
							<div class="callout-title">Capitalized tags are components</div>
							<p>A tag starting with an uppercase letter is a component (<code>&lt;Button /&gt;</code>), not an HTML element. Lowercase tags become DOM elements.</p>
						</div>
					</div>

					<h2 id="reactivity">Reactivity</h2>
					<p>State is wrapped in a Proxy. Each binding subscribes to the fields it reads, and a write re-runs only the effects that depend on that field.</p>
					<div class="codeblock" data-code="reactivity" data-lang="tardis"></div>
					<div class="steps">
						<div class="step-row">
							<h3>Declare state</h3>
							<p>Fields are declared with types and defaults in the <code>state</code> block.</p>
						</div>
						<div class="step-row">
							<h3>Bind in UI</h3>
							<p>Reading <code>state.count</code> inside a binding registers that effect as a dependency of <code>count</code>.</p>
						</div>
						<div class="step-row">
							<h3>Write to update</h3>
							<p><code>$update(state.count, v)</code> changes the value; only subscribed effects re-run.</p>
						</div>
					</div>

					<h2 id="runtime">Runtime API</h2>
					<p>The runtime is the single object compiled code imports. Functions are grouped by concern.</p>
					<h3>State</h3>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Function</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>$update(ref, value)</td><td>Set a state key and trigger dependent effects.</td></tr>
								<tr><td>$toggle(ref)</td><td>Flip a boolean state key.</td></tr>
								<tr><td>$reset(state, initial)</td><td>Reset keys back to their initial values.</td></tr>
								<tr><td>$batch(fn)</td><td>Coalesce updates in the callback into a single synchronous flush.</td></tr>
							</tbody>
						</table>
					</div>
					<h3>Rendering</h3>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Function</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>$if(cond, build)</td><td>Conditional mount/remove with a comment anchor.</td></tr>
								<tr><td>$each(list, build)</td><td>List rendering; clears and rebuilds on change.</td></tr>
								<tr><td>$show(cond, build)</td><td>Toggles display without unmounting.</td></tr>
								<tr><td>$portal(selector, build)</td><td>Renders into an external DOM target.</td></tr>
								<tr><td>text(value)</td><td>Text node, reactive when given a function.</td></tr>
								<tr><td>bind(el, prop, fn)</td><td>Bind a DOM property to a reactive expression.</td></tr>
								<tr><td>bindClass / bindAttr</td><td>Bind class / attribute reactively.</td></tr>
								<tr><td>resolveStyles(styles, key)</td><td>Resolve a style token to its class string.</td></tr>
							</tbody>
						</table>
					</div>
					<h3>Navigation &amp; data</h3>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Function</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>$navigate(path)</td><td>Client-side navigation.</td></tr>
								<tr><td>$back() / $forward()</td><td>History traversal.</td></tr>
								<tr><td>$params</td><td>Live dynamic-route parameters.</td></tr>
								<tr><td>$fetch(url)</td><td>Chainable request helper.</td></tr>
								<tr><td>$(selector)</td><td>DOM / component selection.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="router">Router</h2>
					<p>Routing is file-based and mounted by <code>createRouter</code>. The build emits routes from the pages directory and starts the router.</p>
					<div class="codeblock" data-code="router" data-lang="js"></div>
					<ul>
						<li><strong>Dynamic segments</strong> — <code>pages/blog/[id].tardis</code> becomes <code>/blog/:id</code>; read values from <code>$params</code>.</li>
						<li><strong>Link interception</strong> — internal <code>&lt;a href&gt;</code> clicks are captured; external, hash, and modifier-key clicks pass through.</li>
						<li><strong>Hash scroll</strong> — navigating to <code>#section</code> scrolls to the element after render.</li>
						<li><strong>404</strong> — unmatched paths render a default not-found node.</li>
					</ul>

					<h2 id="selector">Selector</h2>
					<p><code>$(selector)</code> returns a jQuery-inspired selection. Lowercase selectors query the DOM; an uppercase name selects mounted component instances.</p>
					<div class="codeblock" data-code="selector" data-lang="js"></div>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Method</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>show() / hide() / toggle()</td><td>Toggle display.</td></tr>
								<tr><td>addClass / removeClass / toggleClass</td><td>Class manipulation.</td></tr>
								<tr><td>attr(key, val?)</td><td>Get or set an attribute.</td></tr>
								<tr><td>val(value?)</td><td>Get or set an input value.</td></tr>
								<tr><td>focus() / blur()</td><td>Focus control.</td></tr>
								<tr><td>remove()</td><td>Detach elements.</td></tr>
								<tr><td>rect() / width() / height()</td><td>Geometry.</td></tr>
								<tr><td>scrollIntoView() / scrollTo(opts)</td><td>Scrolling.</td></tr>
								<tr><td>fadeIn / fadeOut / slideUp / slideDown</td><td>Lightweight effects.</td></tr>
								<tr><td>$update / $reset / methods</td><td>Component instances only.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="styles">Styles</h2>
					<p>A <code>style</code> block maps tokens to class strings. Referencing a token in <code>class</code> resolves it; dotted keys add variants driven by props or state.</p>
					<div class="codeblock" data-code="styles" data-lang="tardis"></div>
					<ul>
						<li><strong>style(tailwind)</strong> — tokens are utility classes.</li>
						<li><strong>style(css)</strong> — tokens are inline style strings.</li>
						<li><strong>style</strong> (raw) — the block is injected as a stylesheet.</li>
						<li><strong>variant.primary</strong> — applied when <code>props.variant === "primary"</code>.</li>
						<li><strong>loading.true</strong> — boolean shorthand for a state key.</li>
					</ul>

					<h2 id="events">Lifecycle events</h2>
					<p>The <code>events</code> block registers lifecycle handlers. Mount callbacks run after the node is inserted; destroy callbacks run before it is removed.</p>
					<div class="codeblock" data-code="events" data-lang="tardis"></div>
					<div class="callout callout-tip">
						<span class="callout-icon" data-icon="tip"></span>
						<div class="callout-body">
							<div class="callout-title">Cleanup</div>
							<p>Use <code>onDestroy</code> to clear timers, listeners, or subscriptions. The router disposes the outgoing route node and its event handles on navigation.</p>
						</div>
					</div>

					<h2 id="registry">Component registry</h2>
					<p>Every mounted blueprint is registered by name. The registry powers component selection and cross-component queries.</p>
					<div class="codeblock" data-code="registry" data-lang="js"></div>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Function</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>register(name, instance)</td><td>Register an instance, returns an id.</td></tr>
								<tr><td>unregister(id)</td><td>Remove an instance by id.</td></tr>
								<tr><td>getAll(name)</td><td>All instances of a blueprint.</td></tr>
								<tr><td>getById(id)</td><td>Instance by id, or null.</td></tr>
								<tr><td>getByClass(name, cls)</td><td>Instances whose element has a class.</td></tr>
								<tr><td>getByPropValue(name, k, v)</td><td>Instances matching a prop value.</td></tr>
								<tr><td>getByStateValue(name, k, v)</td><td>Instances matching a state value.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="cli">CLI</h2>
					<p>The bundled CLI scaffolds, develops, builds, and previews projects.</p>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Command</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>tardis init</td><td>Scaffold pages, components, config, and package.json in the current directory.</td></tr>
								<tr><td>tardis dev</td><td>Dev server with a WebSocket reload channel.</td></tr>
								<tr><td>tardis build</td><td>Compile pages and components into the output directory.</td></tr>
								<tr><td>tardis preview</td><td>Serve the built output locally.</td></tr>
								<tr><td>create-tardis-app name</td><td>Create a new project in a subdirectory.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="config">Configuration</h2>
					<p><code>tardis.config.js</code> drives page scanning, output, head tags, and static copying.</p>
					<div class="codeblock" data-code="config" data-lang="js"></div>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Key</th><th>Default</th><th>Description</th></tr></thead>
							<tbody>
								<tr><td>pages</td><td>./pages</td><td>Directory scanned for route blueprints.</td></tr>
								<tr><td>components</td><td>./components</td><td>Directory scanned for reusable components.</td></tr>
								<tr><td>outDir</td><td>./dist</td><td>Build output directory.</td></tr>
								<tr><td>port</td><td>3000</td><td>Dev server port (auto-increments if busy).</td></tr>
								<tr><td>title</td><td>tardis app</td><td>Document title.</td></tr>
								<tr><td>head</td><td>[]</td><td>Raw tags injected into the document head.</td></tr>
								<tr><td>staticDir</td><td>./public</td><td>Static assets copied to the output root.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="compiler">Compiler pipeline</h2>
					<p>Build-time does the structural work; the runtime only binds.</p>
					<div class="steps">
						<div class="step-row">
							<h3>lex()</h3>
							<p>Tokenize source into section keywords, literals, operators, and raw UI/script blocks.</p>
						</div>
						<div class="step-row">
							<h3>parse()</h3>
							<p>Build a typed AST: props, state, computed, methods, events, style, and UI nodes.</p>
						</div>
						<div class="step-row">
							<h3>compile()</h3>
							<p>Emit JavaScript that creates DOM nodes, registers bindings, and wires events against the runtime.</p>
						</div>
						<div class="step-row">
							<h3>transpile + emit</h3>
							<p>TypeScript-transpile the output, rewrite runtime imports, and emit route modules plus the runtime bundle.</p>
						</div>
					</div>
					<p>A blueprint compiles to a module that imports the runtime and returns a root element:</p>
					<div class="codeblock" data-code="compiled" data-lang="js"></div>

					<h2 id="errors">Errors</h2>
					<p>Compile-time problems throw a <code>TardisError</code> with file, line, and column.</p>
					<div class="codeblock" data-code="error" data-lang="text"></div>
					<ul>
						<li><strong>Unknown section</strong> — a top-level key that is not a valid blueprint section.</li>
						<li><strong>Bad prop type</strong> — the parser suggests the closest valid type (Levenshtein distance ≤ 2).</li>
						<li><strong>Missing ui</strong> — every blueprint must declare a <code>ui</code> block.</li>
						<li><strong>Unknown style mode</strong> — valid modes are <code>tailwind</code> and <code>css</code>.</li>
					</ul>

					<h2 id="examples">Examples</h2>
					<p>Working examples live in the repository under <code>examples/</code>.</p>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead><tr><th>Example</th><th>Demonstrates</th></tr></thead>
							<tbody>
								<tr><td>examples/counter</td><td>State, computed, methods, and styled buttons.</td></tr>
								<tr><td>examples/todo</td><td>Lists, boolean state, filters, and computed counts.</td></tr>
							</tbody>
						</table>
					</div>

					<h2 id="benchmarks">Benchmarks</h2>
					<p>A jsdom benchmark harness compares TardisJS with React and Vue on the same workload: mount a 200-item list, then write one field 500 times. Numbers are generated by <code>bench/run.mjs</code>.</p>
					<div class="callout callout-note">
						<span class="callout-icon" data-icon="info"></span>
						<div class="callout-body">
							<div class="callout-title">Read with care</div>
							<p>These are jsdom micro-benchmarks, not real-browser results, and are specific to this workload. See the <a href="/#benchmarks">benchmark charts</a> on the landing page.</p>
						</div>
					</div>

					<h2 id="faq">FAQ</h2>
					<h3>Is TardisJS a React replacement?</h3>
					<p>No. It is an experimental, blueprint-first model with a smaller ecosystem. React, Vue, and Svelte are more mature choices for most production teams today.</p>
					<h3>Does it support server-side rendering?</h3>
					<p>Not yet. The build produces a client SPA. SSR and hydration are not implemented.</p>
					<h3>How does reactivity differ from Vue?</h3>
					<p>Both use Proxies, but TardisJS binds at the field level with no scheduler or virtual tree — a write runs the bound effects directly.</p>
					<h3>Can I use Tailwind?</h3>
					<p>Yes. Add the Tailwind CDN tag to <code>head</code> and use <code>style(tailwind)</code> tokens, or use <code>style(css)</code> / raw stylesheets.</p>

					<h2 id="contributing">Contributing</h2>
					<ol>
						<li>Create a branch scoped to one concern.</li>
						<li>Add or update tests next to the affected subsystem.</li>
						<li>Run <code>npm run typecheck</code> and <code>npm test</code> before review.</li>
						<li>Provide a minimal reproduction for parser or compiler defects.</li>
					</ol>
					<p>The project is MIT licensed. Source: <a href="https://github.com/devansharora18/tardisjs" target="_blank" rel="noreferrer">github.com/devansharora18/tardisjs</a>.</p>

					<div class="docs-pager">
						<a class="prev" href="/"><span class="dir">← Home</span><span class="label">Landing page</span></a>
						<a class="next" href="#quickstart"><span class="dir">Next →</span><span class="label">Quick start</span></a>
					</div>
				</main>

				<aside class="docs-toc" aria-label="On this page">
					<h3>On this page</h3>
					<a href="#introduction">Introduction</a>
					<a href="#quickstart">Quick start</a>
					<a href="#structure">Project structure</a>
					<a href="#blueprints">Blueprint syntax</a>
					<a href="#templating">UI &amp; templating</a>
					<a href="#reactivity">Reactivity</a>
					<a href="#runtime">Runtime API</a>
					<a href="#router">Router</a>
					<a href="#selector">Selector</a>
					<a href="#styles">Styles</a>
					<a href="#events">Lifecycle events</a>
					<a href="#registry">Component registry</a>
					<a href="#cli">CLI</a>
					<a href="#config">Configuration</a>
					<a href="#compiler">Compiler pipeline</a>
					<a href="#errors">Errors</a>
					<a href="#examples">Examples</a>
					<a href="#benchmarks">Benchmarks</a>
					<a href="#faq">FAQ</a>
					<a href="#contributing">Contributing</a>
				</aside>
			</div>
			<Footer />
		</div>
	}
	script {
		function esc(s) {
			return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
		}
		function hiTardis(code) {
			let h = esc(code)
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/"([^"\n]*)"/g, '<span class="syn-str">"$1"</span>')
			h = h.replace(/\b(blueprint|props|state|computed|methods|events|style|script|ui|tailwind|css)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/\b(number|string|boolean|array|object|function)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/(\$update|\$toggle|\$reset|\$batch|\$if|\$each|\$show|\$navigate|\$params|\$fetch|\$portal|\$back|\$forward)\b/g, '<span class="syn-fn">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			h = h.replace(/(&lt;\/?)([A-Za-z][\w-]*)/g, '$1<span class="syn-tag">$2</span>')
			h = h.replace(/(@[\w]+)/g, '<span class="syn-attr">$1</span>')
			return h
		}
		function hiJs(code) {
			let h = esc(code)
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/"([^"\n]*)"/g, '<span class="syn-str">"$1"</span>')
			h = h.replace(/'([^'\n]*)'/g, '<span class="syn-str">\'$1\'</span>')
			h = h.replace(/\b(import|from|export|function|return|const|let|new|document|window)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/(\$runtime|\$el|\$navigate|\$update|\$fetch)\b/g, '<span class="syn-fn">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			return h
		}
		function hiBash(code) {
			let h = esc(code)
			h = h.replace(/(#[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			return h
		}
		function hiText(code) { return esc(code) }

		const SNIPPETS = {
			quickstart: 'npx create-tardis-app my-app\ncd my-app\nnpm install\nnpm run dev',
			init: 'npx tardis init\nnpx tardis dev',
			structure: 'my-app/\n  pages/\n    index.tardis        # -> /\n    about.tardis        # -> /about\n    blog/[id].tardis    # -> /blog/:id\n  components/\n    Button.tardis\n  public/\n  tardis.config.js\n  package.json',
			blueprint: 'blueprint Counter {\n  props { step: number = 1 }\n  state { count: number = 0 }\n  computed { doubled: state.count * 2 }\n  methods {\n    increment: () => $update(state.count, state.count + 1)\n  }\n  events { onMount: () => console.log("mounted") }\n  style(tailwind) { value: "text-6xl font-bold" }\n  ui {\n    <button class={"value"} @click={methods.increment}>\n      {state.count}\n    </button>\n  }\n}',
			templating: '<main>\n  <p>{state.count}</p>\n  <input value={state.name} @input={methods.setName} />\n  <button class={"btn"} @click={methods.increment}>+1</button>\n  <Button label={props.title} />\n</main>',
			controlflow: '$if(state.loggedIn) {\n  <p>Welcome back</p>\n}\n\n$show(state.open) {\n  <div class="panel">...</div>\n}\n\n$each(state.items, (item) => {\n  <li>{item.label}</li>\n})',
			reactivity: 'state {\n  count: number = 0\n}\nmethods {\n  increment: () => $update(state.count, state.count + 1)\n}\nui {\n  <p>{state.count}</p>\n}',
			router: "import { createRouter } from 'tardisjs/runtime'\nimport { Home } from '/pages/index.js'\nimport { Post } from '/pages/blog/[id].js'\n\nconst router = createRouter([\n  { path: '/', component: Home },\n  { path: '/blog/:id', component: Post },\n])\n\nrouter.start()\n// inside a component:\n$navigate('/blog/42')",
			selector: "$('.panel').hide().addClass('muted')\n$('input#email').val('me@example.com')\n\n// component selection (uppercase = component)\n$('Modal#confirm').$update('open', false)\n$('Counter').methods.increment()",
			styles: 'blueprint Button {\n  props { variant: "primary" | "secondary" = "primary" }\n  style(tailwind) {\n    base: "rounded-lg px-4 py-2"\n    "variant.primary": "bg-white text-black"\n    "variant.secondary": "border border-white/20"\n  }\n  ui {\n    <button class={props.variant}>{props.label}</button>\n  }\n}',
			events: 'blueprint Ticker {\n  state { n: number = 0 }\n  events {\n    onMount: () => console.log("mounted")\n    onUpdate: () => console.log("updated")\n    onDestroy: () => console.log("cleanup")\n  }\n  ui { <p>{state.n}</p> }\n}',
			registry: "import { getAll, getById, getByPropValue } from 'tardisjs/runtime'\n\ngetAll('Counter')                 // every Counter instance\ngetById('Counter_ab12cd')         // one instance by id\ngetByPropValue('Tab', 'active', true)",
			config: "export default {\n  pages: './pages',\n  components: './components',\n  outDir: './dist',\n  port: 3000,\n  title: 'my app',\n  head: ['<script src=\"https://cdn.tailwindcss.com\"></script>'],\n  staticDir: './public',\n}",
			compiled: "import { $runtime } from 'tardisjs/runtime'\n\nexport function Counter(props = {}) {\n  const _state = $runtime.state({ count: 0 })\n  const _methods = {\n    increment: () => $runtime.update(_state, 'count', _state.count + 1),\n  }\n  const _root = (() => {\n    const el = document.createElement('p')\n    const text = document.createTextNode('')\n    $runtime.bind(text, 'textContent', () => String(_state.count))\n    el.appendChild(text)\n    return el\n  })()\n  return _root\n}",
			error: 'TardisError: Counter.tardis line 3 col 12\n  Unknown prop type "nubmer" — did you mean "number"?'
		}

		const LANG = { bash: hiBash, text: hiText, tardis: hiTardis, js: hiJs }
		document.querySelectorAll('.codeblock').forEach(block => {
			const key = block.getAttribute('data-code')
			const lang = block.getAttribute('data-lang') || 'text'
			const raw = SNIPPETS[key] || ''
			block.innerHTML =
				'<div class="codeblock-bar"><span class="codeblock-lang">' + lang + '</span><button class="copy-code">Copy</button></div>' +
				'<pre><code>' + (LANG[lang] || hiText)(raw) + '</code></pre>'
			const btn = block.querySelector('.copy-code')
			btn.addEventListener('click', () => {
				if (navigator.clipboard) navigator.clipboard.writeText(raw)
				btn.textContent = 'Copied'
				setTimeout(() => { btn.textContent = 'Copy' }, 1500)
			})
		})

		const ICONS = {
			info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
			tip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V18h8v-3.3A7 7 0 0 0 12 2z"/></svg>',
			warn: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>'
		}
		document.querySelectorAll('.callout-icon').forEach(el => {
			el.innerHTML = ICONS[el.getAttribute('data-icon')] || ''
		})

		const copyLlm = document.getElementById('copy-llm')
		if (copyLlm) {
			copyLlm.addEventListener('click', () => {
				if (navigator.clipboard) navigator.clipboard.writeText(location.origin + location.pathname)
				copyLlm.textContent = 'Copied'
				setTimeout(() => { copyLlm.textContent = 'Copy for LLM' }, 1500)
			})
		}

		const anchors = Array.prototype.slice.call(document.querySelectorAll('.docs-content h2[id]'))
		const navLinks = Array.prototype.slice.call(document.querySelectorAll('.docs-sidebar a, .docs-toc a'))
		function syncActive() {
			let current = anchors.length ? anchors[0].id : null
			const y = window.scrollY + 120
			anchors.forEach(a => { if (a.offsetTop <= y) current = a.id })
			navLinks.forEach(l => {
				const target = (l.getAttribute('href') || '').replace('#', '')
				l.classList.toggle('active', target === current)
			})
		}
		window.addEventListener('scroll', syncActive, { passive: true })
		syncActive()
	}
}
