blueprint Docs {
	style {
		.docs-page {
			background: var(--bg);
			color: var(--text);
			min-height: 100vh;
		}
		.docs-shell {
			max-width: 1280px;
			margin: 0 auto;
			padding: 28px 24px 72px;
			display: grid;
			grid-template-columns: 236px minmax(0, 1fr) 210px;
			gap: 36px;
			align-items: start;
		}
		/* ── left nav ── */
		.docs-sidebar {
			position: sticky;
			top: 76px;
			max-height: calc(100vh - 96px);
			overflow-y: auto;
		}
		.docs-group { margin-bottom: 22px; }
		.docs-group-title {
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--text-muted);
			margin-bottom: 8px;
		}
		.docs-group-title .count {
			color: var(--text-muted);
			opacity: 0.7;
		}
		.docs-sidebar a {
			display: block;
			font-size: 13.5px;
			color: var(--text-secondary);
			padding: 5px 10px;
			border-radius: var(--radius-sm);
			border-left: 2px solid transparent;
		}
		.docs-sidebar a:hover {
			color: var(--text);
			background: var(--surface);
			text-decoration: none;
		}
		.docs-sidebar a.active {
			color: var(--text);
			background: var(--surface);
			border-left-color: var(--accent);
		}
		/* ── main content ── */
		.docs-content { min-width: 0; }
		.docs-crumb {
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			color: var(--text-muted);
			margin-bottom: 14px;
		}
		.docs-crumb a { color: var(--text-muted); }
		.docs-crumb a:hover { color: var(--text); text-decoration: none; }
		.docs-head {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			border-bottom: 1px solid var(--border);
			padding-bottom: 16px;
			margin-bottom: 26px;
		}
		.docs-head h1 {
			font-size: clamp(28px, 3.4vw, 38px);
			font-weight: 800;
			letter-spacing: -0.03em;
			line-height: 1.05;
		}
		.docs-actions { display: flex; gap: 8px; }
		.docs-action {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			color: var(--text-secondary);
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			padding: 6px 10px;
			cursor: pointer;
		}
		.docs-action:hover { color: var(--text); border-color: var(--border-strong); }
		.docs-content h2 {
			font-size: 24px;
			font-weight: 700;
			letter-spacing: -0.02em;
			margin: 40px 0 12px;
			scroll-margin-top: 84px;
		}
		.docs-content h3 {
			font-size: 17px;
			font-weight: 600;
			margin: 26px 0 8px;
			scroll-margin-top: 84px;
		}
		.docs-content p,
		.docs-content li {
			color: var(--text-secondary);
			font-size: 15px;
			line-height: 1.7;
		}
		.docs-content p { margin-bottom: 12px; }
		.docs-content strong { color: var(--text); font-weight: 600; }
		.docs-content ul,
		.docs-content ol { padding-left: 20px; margin: 8px 0 14px; }
		.docs-content li + li { margin-top: 5px; }
		.docs-content :not(pre) > code {
			font-family: 'Geist Mono', monospace;
			font-size: 13px;
			color: var(--text);
			background: var(--code-bg);
			border: 1px solid var(--border);
			border-radius: 5px;
			padding: 1px 6px;
		}
		.docs-content a { color: var(--accent); }
		/* ── code block ── */
		.codeblock {
			position: relative;
			margin: 14px 0 18px;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			background: var(--code-bg);
			overflow: hidden;
		}
		.codeblock-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 8px 12px;
			border-bottom: 1px solid var(--border);
			background: var(--surface);
		}
		.codeblock-lang {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		.codeblock pre {
			padding: 14px 16px;
			overflow-x: auto;
			font-size: 13px;
			line-height: 1.65;
		}
		.codeblock pre code { color: var(--text); white-space: pre; }
		.copy-code {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			color: var(--text-muted);
			background: none;
			border: 1px solid var(--border);
			border-radius: 5px;
			padding: 3px 8px;
			cursor: pointer;
		}
		.copy-code:hover { color: var(--text); border-color: var(--border-strong); }
		/* ── callout ── */
		.callout {
			display: flex;
			gap: 12px;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 14px 16px;
			margin: 16px 0;
			background: var(--surface);
		}
		.callout-icon {
			flex-shrink: 0;
			width: 20px;
			height: 20px;
			margin-top: 1px;
		}
		.callout-body { min-width: 0; }
		.callout-title {
			font-size: 13px;
			font-weight: 600;
			margin-bottom: 2px;
		}
		.callout p { font-size: 14px; margin: 0; }
		.callout-note { border-left: 2px solid var(--accent); }
		.callout-note .callout-title,
		.callout-note .callout-icon { color: var(--accent); }
		.callout-tip { border-left: 2px solid var(--success); }
		.callout-tip .callout-title,
		.callout-tip .callout-icon { color: var(--success); }
		.callout-warning { border-left: 2px solid var(--warning); }
		.callout-warning .callout-title,
		.callout-warning .callout-icon { color: var(--warning); }
		/* ── tables ── */
		.docs-table-wrap {
			overflow-x: auto;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			margin: 14px 0 18px;
		}
		table.docs-table { width: 100%; border-collapse: collapse; font-size: 14px; }
		table.docs-table th,
		table.docs-table td {
			text-align: left;
			padding: 10px 14px;
			border-bottom: 1px solid var(--border);
			vertical-align: top;
		}
		table.docs-table tbody tr:last-child td { border-bottom: none; }
		table.docs-table th {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		table.docs-table td { color: var(--text-secondary); }
		table.docs-table td:first-child {
			color: var(--text);
			font-family: 'Geist Mono', monospace;
			font-size: 13px;
			white-space: nowrap;
		}
		/* ── steps ── */
		.steps { counter-reset: step; margin: 16px 0; }
		.step-row {
			position: relative;
			padding-left: 40px;
			padding-bottom: 20px;
		}
		.step-row::before {
			counter-increment: step;
			content: counter(step);
			position: absolute;
			left: 0;
			top: 0;
			width: 26px;
			height: 26px;
			border-radius: 50%;
			border: 1px solid var(--border);
			background: var(--surface);
			color: var(--text);
			font-family: 'Geist Mono', monospace;
			font-size: 12px;
			display: grid;
			place-items: center;
		}
		.step-row::after {
			content: "";
			position: absolute;
			left: 13px;
			top: 30px;
			bottom: 0;
			width: 1px;
			background: var(--border);
		}
		.step-row:last-child::after { display: none; }
		.step-row h3 { margin: 2px 0 4px; }
		/* ── pager ── */
		.docs-pager {
			display: flex;
			justify-content: space-between;
			gap: 12px;
			margin-top: 48px;
			padding-top: 20px;
			border-top: 1px solid var(--border);
		}
		.docs-pager a {
			flex: 1;
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 12px 16px;
			color: var(--text-secondary);
		}
		.docs-pager a:hover { border-color: var(--border-strong); text-decoration: none; }
		.docs-pager .dir {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--text-muted);
		}
		.docs-pager .label { display: block; margin-top: 3px; color: var(--text); font-size: 14px; }
		.docs-pager .next { text-align: right; }
		/* ── right toc ── */
		.docs-toc {
			position: sticky;
			top: 76px;
			max-height: calc(100vh - 96px);
			overflow-y: auto;
		}
		.docs-toc h3 {
			font-family: 'Geist Mono', monospace;
			font-size: 11px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--text-muted);
			margin-bottom: 10px;
		}
		.docs-toc a {
			display: block;
			font-size: 13px;
			color: var(--text-muted);
			padding: 4px 0;
			border-left: 2px solid transparent;
			padding-left: 10px;
		}
		.docs-toc a:hover { color: var(--text); text-decoration: none; }
		.docs-toc a.active { color: var(--text); border-left-color: var(--accent); }
		@media (max-width: 1120px) {
			.docs-shell { grid-template-columns: 220px minmax(0, 1fr); }
			.docs-toc { display: none; }
		}
		@media (max-width: 860px) {
			.docs-shell { grid-template-columns: 1fr; gap: 20px; padding: 20px 18px 56px; }
			.docs-sidebar {
				position: static;
				max-height: none;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 14px;
				background: var(--surface);
			}
			.docs-group { margin-bottom: 14px; }
		}
	}
	ui {
		<div class="docs-page">
			<Navbar />
			<div class="docs-shell">
				<aside class="docs-sidebar" aria-label="Documentation">
					<div class="docs-group">
						<div class="docs-group-title"><span>Getting started</span><span class="count">3</span></div>
						<a href="#introduction">Introduction</a>
						<a href="#quickstart">Quick start</a>
						<a href="#structure">Project structure</a>
					</div>
					<div class="docs-group">
						<div class="docs-group-title"><span>Core concepts</span><span class="count">3</span></div>
						<a href="#blueprints">Blueprint syntax</a>
						<a href="#templating">UI &amp; templating</a>
						<a href="#reactivity">Reactivity</a>
					</div>
				</aside>

				<main class="docs-content">
					<nav class="docs-crumb"><a href="/">Docs</a> / Introduction</nav>
					<div class="docs-head">
						<h1 id="introduction">Introduction</h1>
						<div class="docs-actions">
							<button class="docs-action" id="copy-llm">Copy for LLM</button>
							<a class="docs-action" href="https://github.com/devansharora18/tardisjs" target="_blank" rel="noreferrer">Open</a>
						</div>
					</div>

					<p><strong>TardisJS</strong> is a compiler-driven frontend framework built around a blueprint DSL. It compiles <code>.tardis</code> files to plain JavaScript modules plus a small runtime (~7KB gzipped), using Proxy-based reactivity and direct DOM bindings — no virtual DOM, no reconciliation.</p>

					<div class="callout callout-note">
						<span class="callout-icon" data-icon="info"></span>
						<div class="callout-body">
							<div class="callout-title">Experimental</div>
							<p>TardisJS is blueprint-first by design and meant for teams who want explicit generated output and a small runtime surface. For SSR and a large ecosystem today, React or Vue remain safer choices.</p>
						</div>
					</div>

					<h2 id="quickstart">Quick start</h2>
					<p>Scaffold a project, install dependencies, and start the dev server:</p>
					<div class="codeblock" data-code="quickstart" data-lang="bash"></div>
					<p>Or initialize inside an existing directory:</p>
					<div class="codeblock" data-code="init" data-lang="bash"></div>

					<h2 id="structure">Project structure</h2>
					<p>A project is just pages, components, static assets, and a config file:</p>
					<div class="codeblock" data-code="structure" data-lang="text"></div>
					<p>Routes come from the <code>pages/</code> directory — <code>pages/index.tardis</code> maps to <code>/</code> and <code>pages/blog/[id].tardis</code> maps to <code>/blog/:id</code>.</p>

					<h2 id="blueprints">Blueprint syntax</h2>
					<p>A <strong>blueprint</strong> is a named unit with optional sections. Only <code>ui</code> is required.</p>
					<div class="codeblock" data-code="blueprint" data-lang="tardis"></div>
					<div class="callout callout-tip">
						<span class="callout-icon" data-icon="tip"></span>
						<div class="callout-body">
							<div class="callout-title">Section order</div>
							<p>Sections may appear in any order. The compiler emits them in a fixed sequence, so the generated file is deterministic regardless of source order.</p>
						</div>
					</div>

					<h2 id="templating">UI &amp; templating</h2>
					<p>The <code>ui</code> block is HTML-like with reactive bindings. Text interpolates with braces, attributes accept expressions, and events bind with <code>@</code>.</p>
					<div class="codeblock" data-code="templating" data-lang="tardis"></div>
					<h3>Control flow</h3>
					<p>Conditionals and lists are provided by runtime helpers inside <code>ui</code>:</p>
					<div class="codeblock" data-code="controlflow" data-lang="tardis"></div>
					<div class="callout callout-warning">
						<span class="callout-icon" data-icon="warn"></span>
						<div class="callout-body">
							<div class="callout-title">Component names are capitalized</div>
							<p>A tag starting with an uppercase letter is treated as a component (<code>&lt;Button /&gt;</code>), not an HTML element. Lowercase tags become DOM elements.</p>
						</div>
					</div>

					<h2 id="reactivity">Reactivity</h2>
					<p>State is wrapped in a Proxy. Each binding subscribes to the fields it reads, and a write re-runs only the effects that depend on that field.</p>
					<div class="codeblock" data-code="reactivity" data-lang="tardis"></div>
					<div class="steps">
						<div class="step-row">
							<h3>Declare state</h3>
							<p>Fields are declared with types and defaults in the <code>state</code> block.</p>
						</div>
						<div class="step-row">
							<h3>Bind in UI</h3>
							<p>Reading <code>state.count</code> inside a binding registers that effect as a dependency of <code>count</code>.</p>
						</div>
						<div class="step-row">
							<h3>Write to update</h3>
							<p><code>$update(state.count, v)</code> changes the value; only subscribed effects re-run.</p>
						</div>
					</div>

					<div class="docs-pager">
						<a class="prev" href="/"><span class="dir">← Home</span><span class="label">Landing page</span></a>
						<a class="next" href="#quickstart"><span class="dir">Next →</span><span class="label">Quick start</span></a>
					</div>
				</main>

				<aside class="docs-toc" aria-label="On this page">
					<h3>On this page</h3>
					<a href="#introduction">Introduction</a>
					<a href="#quickstart">Quick start</a>
					<a href="#structure">Project structure</a>
					<a href="#blueprints">Blueprint syntax</a>
					<a href="#templating">UI &amp; templating</a>
					<a href="#reactivity">Reactivity</a>
				</aside>
			</div>
			<Footer />
		</div>
	}
	script {
		function esc(s) {
			return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
		}
		function hiTardis(code) {
			let h = esc(code)
			h = h.replace(/(\/\/[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			h = h.replace(/"([^"]*)"/g, '<span class="syn-str">"$1"</span>')
			h = h.replace(/\b(blueprint|props|state|computed|methods|events|style|script|ui|tailwind)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/\b(number|string|boolean|array|object|function)\b/g, '<span class="syn-kw">$1</span>')
			h = h.replace(/(\$update|\$toggle|\$reset|\$batch|\$if|\$each|\$show|\$navigate|\$params|\$fetch|\$portal)\b/g, '<span class="syn-fn">$1</span>')
			h = h.replace(/\b(\d+)\b/g, '<span class="syn-num">$1</span>')
			h = h.replace(/(&lt;\/?)([A-Za-z][\w-]*)/g, '$1<span class="syn-tag">$2</span>')
			h = h.replace(/(@[\w]+)/g, '<span class="syn-attr">$1</span>')
			return h
		}
		function hiBash(code) {
			let h = esc(code)
			h = h.replace(/(#[^\n]*)/g, '<span class="syn-cmt">$1</span>')
			return h
		}
		function hiText(code) { return esc(code) }

		const SNIPPETS = {
			quickstart: 'npx create-tardis-app my-app\ncd my-app\nnpm install\nnpm run dev',
			init: 'npx tardis init\nnpx tardis dev',
			structure: 'my-app/\n  pages/\n    index.tardis        # -> /\n    about.tardis        # -> /about\n    blog/[id].tardis    # -> /blog/:id\n  components/\n    Button.tardis\n  public/\n  tardis.config.js\n  package.json',
			blueprint: 'blueprint Counter {\n  props { step: number = 1 }\n  state { count: number = 0 }\n  computed { doubled: state.count * 2 }\n  methods {\n    increment: () => $update(state.count, state.count + 1)\n  }\n  events { onMount: () => console.log("mounted") }\n  style(tailwind) { value: "text-6xl font-bold" }\n  ui {\n    <button class={"value"} @click={methods.increment}>\n      {state.count}\n    </button>\n  }\n}',
			templating: '<main>\n  <p>{state.count}</p>\n  <input value={state.name} @input={methods.setName} />\n  <button class={"btn"} @click={methods.increment}>+1</button>\n  <Button label={props.title} />\n</main>',
			controlflow: '$if(state.loggedIn) {\n  <p>Welcome back</p>\n}\n\n$show(state.open) {\n  <div class="panel">...</div>\n}\n\n$each(state.items, (item) => {\n  <li>{item.label}</li>\n})',
			reactivity: 'state {\n  count: number = 0\n}\nmethods {\n  increment: () => $update(state.count, state.count + 1)\n}\nui {\n  <p>{state.count}</p>\n}'
		}

		const LANG = { bash: hiBash, text: hiText, tardis: hiTardis }
		document.querySelectorAll('.codeblock').forEach(block => {
			const key = block.getAttribute('data-code')
			const lang = block.getAttribute('data-lang') || 'text'
			const raw = SNIPPETS[key] || ''
			block.innerHTML =
				'<div class="codeblock-bar"><span class="codeblock-lang">' + lang + '</span><button class="copy-code">Copy</button></div>' +
				'<pre><code>' + (LANG[lang] || hiText)(raw) + '</code></pre>'
			const btn = block.querySelector('.copy-code')
			btn.addEventListener('click', () => {
				if (navigator.clipboard) navigator.clipboard.writeText(raw)
				btn.textContent = 'Copied'
				setTimeout(() => { btn.textContent = 'Copy' }, 1500)
			})
		})

		const ICONS = {
			info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
			tip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V18h8v-3.3A7 7 0 0 0 12 2z"/></svg>',
			warn: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>'
		}
		document.querySelectorAll('.callout-icon').forEach(el => {
			el.innerHTML = ICONS[el.getAttribute('data-icon')] || ''
		})

		const copyLlm = document.getElementById('copy-llm')
		if (copyLlm) {
			copyLlm.addEventListener('click', () => {
				const url = location.origin + location.pathname
				if (navigator.clipboard) navigator.clipboard.writeText(url)
				copyLlm.textContent = 'Copied'
				setTimeout(() => { copyLlm.textContent = 'Copy for LLM' }, 1500)
			})
		}

		// active-section highlighting for sidebar + toc
		const anchors = Array.prototype.slice.call(document.querySelectorAll('.docs-content h2[id]'))
		const navLinks = Array.prototype.slice.call(document.querySelectorAll('.docs-sidebar a, .docs-toc a'))
		function syncActive() {
			let current = anchors.length ? anchors[0].id : null
			const y = window.scrollY + 120
			anchors.forEach(a => { if (a.offsetTop <= y) current = a.id })
			navLinks.forEach(l => {
				const target = (l.getAttribute('href') || '').replace('#', '')
				l.classList.toggle('active', target === current)
			})
		}
		window.addEventListener('scroll', syncActive, { passive: true })
		syncActive()
	}
}
