{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "$comment": "SYNTAX-COVERAGE (source.tardis): blueprint + sections (props/state/computed/methods/events/style/ui/script); file-level import X from \"./y.tardis\" (meta.import with captures for keywords/binding/path); <slot> / <slot name=\"n\"> outlets + static slot=\"name\" routing attribute + name attribute; {...spread} on components (keyword.operator.spread); $helpers ($if/$each/$show/$fetch/$update/$toggle/$reset/$batch/$portal/$navigate/$back/$forward/$params + bare $( selector); runtime module APIs (signals: signal/computed/effect/watch/untrack, keyed/fragment/svg, defineComponent/provide/inject/renderSlot, createStore, useForm/validators, createI18n/plural, fade/slide, createHttpClient/useTask); strings/comments/numbers/booleans; @event attributes; HTML-like tags + {expr} interpolation.",
  "name": "Tardis",
  "scopeName": "source.tardis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#runtimeHelpers"
    },
    {
      "include": "#runtimeApis"
    },
    {
      "include": "#slots"
    },
    {
      "include": "#spread"
    },
    {
      "include": "#events"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#markup"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tardis",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tardis",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tardis",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tardis",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.tardis",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tardis",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.tardis",
          "match": "^\\s*(import)\\s+([A-Z][A-Za-z0-9_]*)\\s+(from)\\s+(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": {
              "name": "keyword.control.import.tardis"
            },
            "2": {
              "name": "entity.name.type.component.tardis"
            },
            "3": {
              "name": "keyword.control.import.tardis"
            },
            "4": {
              "name": "string.quoted.tardis"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tardis",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.boolean.tardis",
          "match": "\\b(?:true|false|null|undefined)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.blueprint.tardis",
          "match": "\\bblueprint\\b"
        },
        {
          "name": "keyword.control.section.tardis",
          "match": "\\b(?:props|state|computed|methods|events|style|ui|script)\\b"
        },
        {
          "name": "keyword.control.import.tardis",
          "match": "\\b(?:import|from)\\b"
        },
        {
          "name": "storage.type.tardis",
          "match": "\\b(?:string|number|boolean|array|object|function)\\b"
        }
      ]
    },
    "runtimeHelpers": {
      "patterns": [
        {
          "name": "support.function.tardis",
          "match": "\\$(?:if|each|show|fetch|update|toggle|reset|batch|portal|navigate|back|forward|params)\\b"
        },
        {
          "name": "support.function.selector.tardis",
          "match": "\\$(?=\\()"
        }
      ]
    },
    "runtimeApis": {
      "patterns": [
        {
          "name": "support.function.runtime.tardis",
          "match": "\\b(?:signal|computed|effect|batch|untrack|watch|watchEffect|isSignal|toSignal|keyed|fragment|svg|createRef|setRef|moveChild|defineComponent|normalizeProps|validateProps|renderSlot|provide|inject|lazyComponent|withErrorBoundary|createStore|parseQuery|stringifyQuery|matchPath|resolveRedirect|createGuards|lazyRoute|scrollToId|required|minLength|maxLength|pattern|email|isNumber|min|max|oneOf|custom|validateField|useForm|bindModel|createI18n|plural|fade|slide|cssTransition|prefersReducedMotion|createHttpClient|useTask)\\b"
        }
      ]
    },
    "slots": {
      "patterns": [
        {
          "name": "entity.name.tag.slot.tardis",
          "match": "</?slot\\b"
        },
        {
          "name": "entity.other.attribute-name.slot.tardis",
          "match": "\\b(slot)\\s*(?==)"
        },
        {
          "name": "entity.other.attribute-name.slot-name.tardis",
          "match": "\\b(name)\\s*(?==)"
        }
      ]
    },
    "spread": {
      "patterns": [
        {
          "name": "keyword.operator.spread.tardis",
          "match": "\\{\\s*\\.\\.\\.[^}]+\\}"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.event.tardis",
          "match": "@[a-zA-Z_][\\w-]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.tardis",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.tardis",
          "match": "="
        },
        {
          "name": "keyword.operator.punctuation.tardis",
          "match": "[:.,]"
        },
        {
          "name": "punctuation.definition.brace.tardis",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.bracket.tardis",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.parenthesis.tardis",
          "match": "[()]"
        }
      ]
    },
    "markup": {
      "patterns": [
        {
          "name": "entity.name.tag.tardis",
          "match": "</?[A-Za-z][A-Za-z0-9-]*"
        },
        {
          "name": "entity.other.attribute-name.tardis",
          "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:-]*(?=\\s*=)"
        },
        {
          "name": "meta.embedded.expression.tardis",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#runtimeHelpers"
            },
            {
              "include": "#runtimeApis"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#strings"
            }
          ]
        }
      ]
    }
  }
}
